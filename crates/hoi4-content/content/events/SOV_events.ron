                    name: "用黄金抵押开启装备和顾问通道。",
                    effects: [
                        SetCountryFlag("sov_scw_gold_ledger_opened"),
                        SetGlobalFlag("sov_scw_moscow_gold_credit_ready"),
                        AddPoliticalPower(20.0),
                        AddOpinion(target: "SPR", amount: 15),
                    ],
                    ai_chance: 1.0,
                ),
            ],
        ),
        Event(
            id: "sov.scw_political_conditions",
            title: "援助附带的政治语法",
            description: "共产国际给马德里的措辞很谨慎：统一战线、军事纪律、反法西斯效率、肃清破坏分子。每个词都可以被共和国部长当作建议，也可以被内政部门当作命令。苏联不需要公开接管共和国；只要下一批飞机、步枪和顾问都经过同一套政治语法，马德里就会学会在申请援助之前先修改自己的句子。",
            picture: "GFX_event_soviet_advisors",
            trigger: And([
                Tag("SOV"),
                CountryExists("SPR"),
                HasCountryFlag("sov_scw_advisors_sent"),
                Date(year: 1936, month: 11, day: 20),
                Not(HasCountryFlag("sov_scw_political_conditions_sent")),
            ]),
            mean_time_to_happen_days: 7,
            immediate: [SetCountryFlag("sov_scw_political_conditions_sent")],
            options: [
                EventOption(
                    name: "让援助和政治纪律绑定。",
                    effects: [
                        SetCountryFlag("sov_scw_conditions_bound_to_aid"),
                        SetGlobalFlag("sov_scw_political_conditions_ready"),
