        Event(
            id: "sov.scw_advisors_to_spain",
            title: "派往西班牙的顾问名单",
            description: "伏罗希洛夫桌上的名单没有写成国际主义诗歌。它写的是飞行教官、炮兵顾问、密码员、翻译、港口装卸协调员和政治联络员。西班牙共和国需要装备，但莫斯科更关心装备交给谁、由谁登记、由谁解释失败。援助可以被称为反法西斯团结；在实际文件里，它必须换回可检查的仓库、可信任的军官和对 POUM、CNT 的政治边界。",
            picture: "GFX_event_soviet_advisors",
            trigger: And([
                Tag("SOV"),
                CountryExists("SPR"),
                Date(year: 1936, month: 9, day: 20),
                Not(HasCountryFlag("sov_scw_advisors_sent")),
            ]),
            mean_time_to_happen_days: 6,
            immediate: [SetCountryFlag("sov_scw_advisors_sent")],
            options: [
                EventOption(
                    name: "派出顾问，但把政治条件写进电报。",
                    effects: [
                        SetCountryFlag("sov_scw_advisors_to_spain"),
                        SetCountryFlag("sov_scw_republic_dependency_opened"),
                        SetGlobalFlag("sov_scw_advisors_package_ready"),
                        ArmyExperience(4.0),
                        AirExperience(4.0),
                        AddOpinion(target: "SPR", amount: 20),
                    ],
                    ai_chance: 0.85,
                ),
                EventOption(
                    name: "只送有限装备，避免被西班牙内斗拖住。",
                    effects: [
                        SetCountryFlag("sov_scw_limited_republic_aid"),
                        AddPoliticalPower(10.0),
                        AddOpinion(target: "SPR", amount: 8),
                    ],
                    ai_chance: 0.15,
                ),
            ],
        ),
        Event(
            id: "sov.scw_gold_in_moscow",
            title: "莫斯科的西班牙黄金",
            description: "金条进入仓库时，登记员先核对重量，再核对封条，最后才在单据上写下'西班牙共和国'。对马德里来说，这是购买枪支和飞机的担保；对莫斯科来说，这是让援助变得可追索的抵押。黄金没有意识形态，却能迫使意识形态排队。谁控制账簿，谁就能决定下一批弹药、顾问和政治建议何时离港。",
            picture: "GFX_event_spanish_gold",
            trigger: And([
                Tag("SOV"),
                CountryExists("SPR"),
                Date(year: 1936, month: 10, day: 25),
                Not(HasCountryFlag("sov_scw_spanish_gold_received")),
