                    effects: [
                        SetCountryFlag("spr_militia_autonomy_preserved"),
                        SetCountryFlag("spr_militias_refused_discipline"),
                        AddWarSupport(0.01),
                        AddStability(-0.01),
                        AddToVariable(name: "spr_military_centralization", value: -2.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 2.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        TriggerEvent("hidden.scw_republic_internal_pressure_tick"),
                    ],
                    ai_chance: 0.2,
                ),
            ],
        ),
        Event(
            id: "spr.scw_largo_caballero_government",
            title: "拉尔戈·卡瓦列罗接过钥匙",
            description: "拉尔戈·卡瓦列罗走进首相办公室时，桌上已经堆着三种共和国：盖着官方印章的共和国、工会会所里用粉笔写在黑板上的共和国，以及苏联顾问用红铅笔标注补给线的共和国。他被称作工人领袖，也必须像国家首脑一样签署粮食、军需、逮捕和外交文件。称号可以来自街头，纸张却只能由国家机器执行。

他的支持者希望他证明，工人运动不只是共和国的民兵仓库，而能成为共和国的骨架。他的敌人等待他证明相反的事情：社会主义者一旦坐进办公室，就会让国家滑向革命委员会。共和派律师担心合法性被口号淹没，CNT 代表担心合法性只是新的绳索，共产党人则担心所有不经纪律过滤的热情都会浪费掉莫斯科来之不易的援助。

组阁不是把派系名字放进同一张名单。它是在决定谁能签署逮捕令，谁能分配面包，谁能解释撤退，谁能在战后声称自己代表共和国活了下来。拉尔戈需要一间能运转的内阁，但每增加一把椅子，政府就多一个未来的否决者。",
            picture: "GFX_event_spanish_government",
            trigger: And([
                Tag("SPR"),
                HasCountryFlag("spr_militias_resist_discipline_addressed"),
                Not(HasCountryFlag("spr_largo_caballero_government_formed")),
            ]),
            mean_time_to_happen_days: 4,
            immediate: [SetCountryFlag("spr_largo_caballero_government_formed")],
            options: [
                EventOption(
                    name: "把工会、共和派和共产党都拉进同一张内阁桌。",
                    effects: [
                        SetCountryFlag("spr_broad_wartime_cabinet"),
                        SetCountryFlag("spr_democratic_legitimacy_preserved"),
                        AddPoliticalPower(20.0),
                        AddStability(0.01),
                        AddToVariable(name: "spr_military_centralization", value: 1.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 1.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                    ],
                    ai_chance: 0.45,
                ),
                EventOption(
                    name: "让工人组织成为政府的骨架，内阁必须跟上街头。",
                    effects: [
                        SetCountryFlag("spr_largo_worker_cabinet"),
