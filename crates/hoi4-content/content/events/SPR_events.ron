        Event(
            id: "spr.scw_poum_accused",
            title: "POUM 的名字被写进另一份名单",
            description: "内政部走廊尽头的房间里，打字机响得比炮声更规整。报告把 POUM 写成一个问题：它反对斯大林，质疑苏联顾问，和 CNT 在许多街区共享同一批印刷机、律师和藏枪地点。报告没有直接说他们是叛徒，只是在每一段结尾都留下同一个暗示：如果共和国要靠莫斯科的枪活下去，就不能让莫斯科的敌人在后方公开组织。

安德烈斯·宁的名字在会议桌上被念出来时，几个人没有抬头。共产党代表说统一阵线不能容忍破坏纪律的派别；共和派律师提醒众人，合法性不是胜利后才需要的装饰；CNT 代表则听出了更危险的东西：今天可以用战时安全处理 POUM，明天同一支笔也可以写下 CNT。

保护 POUM 会让苏联顾问怀疑共和国是否值得继续武装。镇压 POUM 能换来更顺畅的补给表，却会把巴塞罗那推向一种熟悉的结论：共和国的监狱终于开始为左翼自己准备牢房。",
            picture: "GFX_event_spanish_cabinet",
            trigger: And([
                Tag("SPR"),
                HasCountryFlag("spr_soviet_advisors_arrived"),
                Or([
                    HasCountryFlag("spr_soviet_advisors_empowered"),
                    HasCountryFlag("spr_soviet_conditions_accepted"),
                    VariableAtLeast(name: "spr_soviet_influence", value: 5.0),
                ]),
                Not(HasCountryFlag("spr_poum_accusation_addressed")),
            ]),
            mean_time_to_happen_days: 5,
            immediate: [SetCountryFlag("spr_poum_accusation_addressed")],
            options: [
                EventOption(
                    name: "保护 POUM 的合法地位，不能让顾问替共和国写逮捕名单。",
                    effects: [
                        SetCountryFlag("poum_protected"),
                        SetCountryFlag("spr_republican_legality_memory"),
                        AddOpinion(target: "SOV", amount: -15),
                        AddStability(0.01),
                        AddWarSupport(-0.01),
                        AddToVariable(name: "spr_soviet_influence", value: -2.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: -1.0),
                        ClampVariable(name: "spr_soviet_influence", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        TriggerEvent("spr.scw_poum_trial"),
                        TriggerEvent("hidden.scw_cnt_uprising_check"),
                    ],
                    ai_chance: 0.25,
                ),
                EventOption(
                    name: "宣布 POUM 非法，先保证苏联补给线和后方纪律。",
                    effects: [
                        SetCountryFlag("poum_outlawed"),
                        SetCountryFlag("spr_cracked_down_on_poum"),
                        AddOpinion(target: "SOV", amount: 15),
                        AddGovernmentOrder(equipment_category: "infantry_equipment", daily_budget_rm: 120000.0, duration_days: 35),
                        AddStability(-0.02),
                        AddToVariable(name: "spr_soviet_influence", value: 2.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 2.0),
                        ClampVariable(name: "spr_soviet_influence", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        TriggerEvent("spr.scw_poum_trial"),
                        TriggerEvent("hidden.scw_cnt_uprising_check"),
                    ],
                    ai_chance: 0.55,
                ),
                EventOption(
                    name: "拖进公开调查，把问题留在法院而不是地下室。",
                    effects: [
                        SetCountryFlag("spr_poum_public_inquiry"),
                        AddPoliticalPower(-10.0),
                        AddToVariable(name: "spr_soviet_influence", value: 1.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 1.0),
                        ClampVariable(name: "spr_soviet_influence", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        TriggerEvent("spr.scw_poum_trial"),
                        TriggerEvent("hidden.scw_cnt_uprising_check"),
                    ],
                    ai_chance: 0.2,
                ),
            ],
        ),
        Event(
            id: "spr.scw_poum_trial",
            title: "审判席旁的空椅子",
            description: "法院门口站着三种人：等着把 POUM 定成法西斯同谋的记者，等着证明共和国仍有法律的律师，以及等着确认下一个被点名者会不会轮到自己的 CNT 代表。审判席旁有一把空椅子，不论坐上去的是宁、地方编辑、民兵联络员还是某个被临时抓来的书记员，它都已经不再只属于一个人。

苏联顾问没有坐在法庭前排。他们不需要。军需清单、进口许可和顾问团备忘录已经坐在那里。共和国可以把审判做成公开程序，让每一份证据都经得起报纸追问；也可以让案件迅速结束，换来更干净的后方和更顺畅的弹药；还可以试图把 POUM 并入反法西斯纪律，给他们留下活路，同时让所有人都不满意。

这场审判真正决定的不是 POUM 是否纯洁，而是共和国会不会为了活下去，把自己最初用来反对叛军的法律语言一层层拆掉。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
