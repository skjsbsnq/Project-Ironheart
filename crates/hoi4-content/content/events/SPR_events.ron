                        AddPoliticalPower(-10.0),
                        AddToVariable(name: "spr_government_authority", value: 0.5),
                        AddToVariable(name: "spr_officer_conspiracy", value: 1.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
