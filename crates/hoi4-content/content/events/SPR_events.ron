                        AddStability(-0.02),
                        AddWarSupport(0.02),
                        ArmyExperience(5.0),
                        AddToVariable(name: "spr_government_authority", value: 1.5),
                        AddToVariable(name: "spr_officer_conspiracy", value: -2.0),
                        AddToVariable(name: "spr_church_right_alarm", value: 1.5),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.3,
