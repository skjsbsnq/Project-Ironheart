                        AddToVariable(name: "spr_military_centralization", value: 2.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 1.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        TriggerEvent("hidden.scw_republic_internal_pressure_tick"),
                    ],
                    ai_chance: 0.35,
