            options: [
                EventOption(
                    name: "把可疑将领调离要害军区，命令今天就发出。",
                    effects: [
                        SetCountryFlag("spr_suspect_officers_transferred"),
                        AddStability(-0.02),
                        AddPoliticalPower(-10.0),
                        AddWarSupport(0.02),
                        AddToVariable(name: "spr_government_authority", value: 1.5),
                        AddToVariable(name: "spr_officer_conspiracy", value: -1.5),
                        AddToVariable(name: "spr_church_right_alarm", value: 1.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.35,
                ),
                EventOption(
                    name: "建立共和国派联络指挥链，让忠诚军官先知道该听谁的。",
                    effects: [
