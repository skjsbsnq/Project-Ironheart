                    name: "让国民警卫队恢复产权秩序，政府不能被庄园门口的木牌拖着走。",
                    effects: [
                        SetCountryFlag("spr_land_seizures_repressed"),
                        AddStability(-0.01),
                        AddPoliticalPower(15.0),
                        AddToVariable(name: "spr_government_authority", value: 1.5),
                        AddToVariable(name: "spr_church_right_alarm", value: -1.0),
