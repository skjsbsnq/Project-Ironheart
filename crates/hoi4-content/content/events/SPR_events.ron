                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.45,
                ),
                EventOption(
                    name: "分化军官团，用调任和承诺把犹豫者从阴谋里拉出来。",
                    effects: [
                        SetCountryFlag("spr_mola_conspiracy_appeased"),
                        AddStability(0.01),
                        AddPoliticalPower(-15.0),
