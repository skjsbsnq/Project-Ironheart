            ],
        ),
        Event(
            id: "spr.scw_barcelona_telephone_exchange",
            title: "电话局楼梯上的枪声",
            description: "巴塞罗那电话局的楼梯很窄，窄到两支同属反法西斯阵线的队伍无法体面地错身而过。共和国警卫说他们只是接管通信中枢，确保前线命令不再经过工会接线员的耳朵。CNT 守卫说电话局是在七月街垒中夺下来的，谁控制线路，谁就控制巴塞罗那听见什么、沉默什么。

最先开枪的人是谁已经不重要。重要的是，每个接线员都知道哪些部长在同谁通话，哪些军官要求切断哪条线路，哪些工会代表在深夜寻找失踪的同志。电话局不是一栋楼，而是共和国、加泰政府、CNT、POUM 和苏联顾问互相监听的神经。现在有人试图把神经从城市身体里拔出来。

如果政府退让，巴塞罗那会继续像一个半自治的革命城市那样运转；如果政府强攻，五月的街道将重新竖起路障；如果谈判，所有人都会把这当成下一次摊牌前的喘息。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            immediate: [SetCountryFlag("spr_barcelona_telephone_exchange_crisis")],
            options: [
                EventOption(
                    name: "警卫队进入电话局，国家必须控制通信。",
                    effects: [
