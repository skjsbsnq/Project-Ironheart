                    ai_chance: 0.3,
                ),
                EventOption(
                    name: "后撤警卫队，承认巴塞罗那暂时不能按瓦伦西亚的命令运转。",
                    effects: [
                        SetCountryFlag("spr_telephone_exchange_backed_down"),
                        SetCountryFlag("cnt_uprising_prevented"),
                        AddStability(0.01),
                        AddWarSupport(-0.01),
                        AddToVariable(name: "spr_military_centralization", value: -2.0),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 1.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
