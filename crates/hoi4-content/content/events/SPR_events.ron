EventDb(
    events: [
        Event(
            id: "spr.scw_opening_history",
            title: "第二共和国的第五个年头",
            description: "1936年的西班牙共和国并不是一个年轻国家，而是一间被太多人同时索取钥匙的办公室。1931年，国王离开马德里时，街上响起的是共和歌、教堂钟声和报纸号外；五年后，留下来的却是未完成的土地改革、被反复改写的军队名册、被关停又重开的工会会所，以及每个省长都学会用两种语气写给内政部的报告。

共和国的敌人说它从诞生那天起就是秩序的叛徒。共和国的拥护者说它只是还没有得到足够时间去兑现自己的承诺。两种说法都太干净了。阿斯图里亚斯的矿井记得1934年的炮声，乡村佃农记得每一次被延期的地契，军官团记得自己的调令如何被议会辩论羞辱，主教府记得学校、婚姻和墓地如何一点点离开教会账簿。每一方都能列出受害者，也都能列出应该由别人偿还的债。

马德里仍然拥有法律、内阁、警察和国旗；但法律在乡村要经过地主、佃农和国民警卫队重新解释，内阁在街头要与工会、长枪党和报纸标题争夺权威，警察在每一次葬礼之后都更难证明自己不是某一派的工具。共和国还没有崩溃。正因为它还没有崩溃，所有人都相信最后一次推搡、最后一次选举、最后一次调令，足以决定西班牙会被谁继承。",
            picture: "GFX_event_spanish_republic",
            trigger: And([
                Tag("SPR"),
                Date(year: 1936, month: 1, day: 1),
                Not(HasCountryFlag("spr_opening_history_read")),
            ]),
            mean_time_to_happen_days: 1,
            immediate: [
                SetCountryFlag("spr_opening_history_read"),
            ],
            options: [
                EventOption(
                    name: "西班牙仍在等待判决。",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),
        Event(
            id: "spr.scw_popular_front_victory",
            title: "人民阵线胜选",
            description: "选举结果在凌晨才从各省陆续送到内政部。马德里的走廊里挤着记者、社会主义者的信使、共和派律师和不断要求接线的省长；楼外，冻了一夜的人群听见“人民阵线胜利”的传言后先是沉默，随后像火一样把口号传过太阳门广场。有人高喊释放十月起义后的囚犯，有人举着被拖延多年的土地改革请愿书，还有工会代表挤进前厅，提醒部长们：选票不是请愿书，而是一张已经到期的收据。

同一清晨，萨拉曼卡的地主俱乐部关上了百叶窗，主教座堂寄来的信封没有拆开就被压在银质镇纸下面，军官食堂里则有人把报纸摊在桌上，问共和国是否已经把国家交给了街头。阿萨尼亚明白，这场胜利不是普通内阁的授权。它是1931年未竟承诺、1934年镇压伤口、军队改革怨恨和乡村饥饿账本的集中到期。共和国赢得了议会，却没有赢得国家机器的服从；赢得了街头，却没有赢得街头的耐心。

部长会议的桌上摆着三份草案。第一份试图把大赦、土地仲裁和军队纪律捆在一起，给共和国争取几个月喘息。第二份要求立刻释放政治犯、恢复被停职的市政委员会、推动土地占用合法化，用胜利压倒反动派的迟滞。第三份则把多数法令推迟到新议会稳定之后，寄望于不刺激教会、军官和信贷市场。每一份都能暂时拯救共和国，也都会告诉某一群西班牙人：他们又一次被出卖了。",
            picture: "GFX_event_spanish_election",
            trigger: And([
                Tag("SPR"),
                Date(year: 1936, month: 2, day: 17),
            ]),
            mean_time_to_happen_days: 1,
            immediate: [
                SetCountryFlag("spr_popular_front_victory"),
            ],
            options: [
                EventOption(
                    name: "把改革写进法令，但让警察和省长先恢复秩序。",
                    effects: [
                        SetCountryFlag("spr_popular_front_moderate_reform"),
                        AddStability(0.02),
                        AddToVariable(name: "spr_government_authority", value: 1.0),
                        AddToVariable(name: "spr_street_mobilization", value: 0.5),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_street_mobilization", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.45,
                ),
                EventOption(
                    name: "共和国欠街头一笔债，今天就开始偿还。",
                    effects: [
                        SetCountryFlag("spr_popular_front_deepened_reform"),
                        AddStability(-0.02),
                        AddWarSupport(0.02),
                        AddToVariable(name: "spr_street_mobilization", value: 2.0),
                        AddToVariable(name: "spr_church_right_alarm", value: 1.5),
                        AddToVariable(name: "spr_government_authority", value: -1.0),
                        ClampVariable(name: "spr_street_mobilization", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.35,
                ),
                EventOption(
                    name: "把火先压下去，别给兵营任何借口。",
                    effects: [
                        SetCountryFlag("spr_popular_front_delayed_reform"),
                        AddPoliticalPower(20.0),
                        AddStability(-0.01),
                        AddToVariable(name: "spr_government_authority", value: 1.5),
                        AddToVariable(name: "spr_officer_conspiracy", value: -0.5),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.2,
                ),
            ],
        ),
        Event(
            id: "spr.scw_government_in_crisis",
            title: "共和国政府陷入危机",
            description: "马德里的部长会议室里，电话铃声没有停过。军区报告互相矛盾，省长们的声音在接线板里断断续续，武器库门口已经挤满带着工会袖章的人。忠于共和国的军官把手按在地图上，反复说明哪些仓库一旦被打开就再也关不上；内政部官员则提醒他们，若仓库不开，许多城市可能连今晚都撑不过去。

共和国仍然合法，但合法性已经被推到走廊、兵营和工人会所之间。法律文书可以证明政府有权指挥军队，却不能保证军官接电话；工会民兵可以在几个小时内填满街垒，却不会自动服从一个曾经逮捕过他们同志的国家机器。每个人都在说“保卫共和国”，只是他们口中的共和国并不完全相同。

内阁必须先决定自己靠什么活过第一周。守住命令链，意味着把国家押给仍愿服从的军官和警卫队；打开仓库，意味着把共和国的生存权分给那些曾被共和国视作麻烦的人。无论哪一种选择，战后的共和国都不会再回到今天早晨以前。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "先守住政府的命令链。",
                    effects: [
                        SetCountryFlag("spr_scw_command_chain_prioritized"),
                        AddToVariable(name: "spr_military_centralization", value: 1.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                    ],
                    ai_chance: 0.45,
                ),
                EventOption(
                    name: "把枪交给愿意保卫共和国的人。",
                    effects: [
                        SetCountryFlag("spr_scw_weapon_depots_opened"),
                        AddManpower(25000),
                        AddToVariable(name: "spr_revolutionary_pressure", value: 2.0),
                        AddToVariable(name: "spr_military_centralization", value: -1.0),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                    ],
                    ai_chance: 0.55,
                ),
            ],
        ),
        Event(
            id: "spr.scw_land_seizures",
            title: "土地占领蔓延到乡村",
            description: "埃斯特雷马杜拉的清晨没有等到马德里的命令。佃农们带着锄头、旧猎枪和一张从镇公所抄来的共和国法令走进橄榄园，把木牌钉在庄园门口，宣称这片地从今天起由村社耕种。市政委员会的书记员站在尘土里，手里攥着还没有盖章的土地仲裁表；地主的代理人则已经骑马去省城找国民警卫队，声称政府若还算政府，就必须保护契约。

送到内政部的不是一份整齐的政治请愿，而是一捆互相打架的纸：村里用铅笔画出的灌溉渠，地主账房递来的欠租名单，面包铺老板写下的赊账本，国民警卫队长用军用电报纸补写的“请示开枪规则”。农业部说改革必须按程序推进，内政部说程序正在被饥饿和枪支追赶，财政部则提醒所有人，若地主开始转移资本，秋收和税收都会先共和国一步崩坏。

部长们面前不是抽象的改革速度，而是粮食、租佃合同、地方警察和枪口。共和国可以把占领合法化，用行政印章追认街头事实；也可以派仲裁员下乡，试图让国家重新成为地主与佃农之间唯一的翻译；或者用警力把土地还给旧主人，证明法律不向人群让步。无论哪一种，乡村都会记住今天谁站在篱笆哪一边，而未来的军队也会从这些记忆里招募士兵。",
            picture: "GFX_event_spanish_land_reform",
            trigger: And([
                Tag("SPR"),
                Date(year: 1936, month: 3, day: 10),
                HasCountryFlag("spr_popular_front_victory"),
                Not(HasCountryFlag("spr_land_crisis_addressed")),
