                        AddPoliticalPower(-15.0),
                        AddToVariable(name: "spr_government_authority", value: 1.0),
                        AddToVariable(name: "spr_officer_conspiracy", value: -1.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.4,
                ),
                EventOption(
                    name: "不要逼军官团摊牌，先用承诺和监视维持表面服从。",
                    effects: [
                        SetCountryFlag("spr_suspect_officers_appeased"),
                        AddStability(0.01),
                        AddPoliticalPower(10.0),
                        AddToVariable(name: "spr_officer_conspiracy", value: 0.5),
                        AddToVariable(name: "spr_government_authority", value: -1.0),
                        ClampVariable(name: "spr_officer_conspiracy", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
