                    ai_chance: 0.2,
                ),
            ],
        ),
        Event(
            id: "spr.scw_church_conflict",
            title: "钟声与火光",
            description: "复活节前的街道比教堂里更拥挤。几座教会学校的墙上被刷上标语，修女从侧门离开时低着头，附近工人会所的年轻人则说他们只是在清算旧秩序的傲慢。省长办公室的桌上摆着一只被烟熏黑的银质圣杯、三本烧焦边角的课本，以及一张写着“学校明天是否开门”的便条。便条没有署名，因为每个人都知道署名意味着选边。

阿萨尼亚翻看各省来信时，笔尖停在同一个词上：秩序。这个词在不同纸面上长着完全不同的脸。主教府用烫金信笺写它，校长用考勤表背面写它，参加葬礼的母亲用沾蜡油的手写它，街区民兵则把它喷在被撬开的校门旁。共和国的世俗法律要求教会退回私人信仰，然而许多村庄里，教会就是学校、慈善、婚姻登记和死亡证明；削弱教会，等同于拆掉旧国家留下的最后一套基层行政。

每一座被辱骂的祭台都会变成右翼晚餐桌上的证词，每一间继续上课的教会学校也会变成工人区里的羞辱。内阁可以公开保护宗教场所，换取教会承认共和国法律；也可以推动更激进的世俗化，让旧势力知道选举已经改变国家；或者只在火势失控时派警察灭火，把冲突留给地方自己消化。钟声还在响，但已经很难分清它是在召人礼拜，还是在给未来的战争报时。",
            picture: "GFX_event_spanish_church",
            trigger: And([
                Tag("SPR"),
                Date(year: 1936, month: 4, day: 20),
                HasCountryFlag("spr_land_crisis_addressed"),
                Not(HasCountryFlag("spr_church_crisis_addressed")),
            ]),
            mean_time_to_happen_days: 4,
            immediate: [
                SetCountryFlag("spr_church_crisis_addressed"),
            ],
            options: [
                EventOption(
                    name: "保护教堂和学校，但要求主教公开承认共和国法律。",
                    effects: [
                        SetCountryFlag("spr_church_compromise"),
                        AddStability(0.02),
                        AddToVariable(name: "spr_government_authority", value: 1.0),
                        AddToVariable(name: "spr_church_right_alarm", value: -1.5),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.4,
                ),
                EventOption(
                    name: "推进世俗学校和教产清查，旧祭台不能再替旧西班牙统治乡村。",
                    effects: [
                        SetCountryFlag("spr_church_secularization_pushed"),
                        AddStability(-0.02),
                        AddWarSupport(0.01),
                        AddToVariable(name: "spr_street_mobilization", value: 1.5),
                        AddToVariable(name: "spr_church_right_alarm", value: 2.5),
                        ClampVariable(name: "spr_street_mobilization", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.35,
                ),
                EventOption(
                    name: "避免正面冲突，让地方警察只处理纵火和械斗。",
                    effects: [
                        SetCountryFlag("spr_church_conflict_drifted"),
                        AddStability(-0.01),
                        AddPoliticalPower(10.0),
                        AddToVariable(name: "spr_church_right_alarm", value: 1.0),
                        AddToVariable(name: "spr_government_authority", value: -0.5),
                        ClampVariable(name: "spr_church_right_alarm", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                    ],
                    ai_chance: 0.25,
                ),
            ],
        ),
        Event(
            id: "spr.scw_falange_street_violence",
            title: "长枪党人在街角开火",
            description: "马德里的午后被一阵短促的枪声撕开。电车停在轨道上，乘客趴在座椅下面，街角的咖啡馆玻璃碎了一地。有人说先开枪的是蓝衫青年，有人说工会纠察队早就带着棍棒等在那里；等警察赶到时，血已经顺着排水沟流到报摊前，第二天的标题也已经写好。真正最先抵达现场的不是警察，而是各派解释者。

警察报告的页边贴着从现场捡回来的东西：一枚蓝色衬衫扣子，半张印着长枪党箭束的传单，一截包着红布的木棍，还有咖啡馆老板写给保险公司的损失清单。报社排字间通宵亮灯，把同一滩血排成两种完全相反的故事；军官俱乐部的烟灰缸旁则多了一句低声重复的话：街道已经不属于政府。长枪党需要烈士证明共和国无能，工会需要烈士证明法西斯已经开战，两边都在等待政府用错误的手势确认自己的宣传。

政府可以取缔长枪党组织，用警力把他们的会所和印刷机一并封掉；也可以扩大巡逻、同时收缴左右两边的武器，试图保住共和国的中立权威；或者把主要精力放在工会纠察队身上，向保守派证明政府仍然能控制街道。可街道秩序不是一个按钮。每一次搜查都会制造新的秘密仓库，每一次宽容都会制造新的葬礼，每一种秩序都会得罪一批愿意为未来流血的人。",
