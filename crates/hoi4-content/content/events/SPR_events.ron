        Event(
            id: "spr.scw_cnt_open_revolt",
            title: "CNT 和 POUM 公开决裂",
            description: "巴塞罗那的路障没有在清晨撤掉。电话局枪声之后，CNT 地方委员会、POUM 联络员和拒绝解散的民兵纵队宣布他们不会再服从瓦伦西亚的命令。共和国政府仍然声称这只是一次治安行动，但加泰罗尼亚的工厂、工会会所和民兵仓库已经开始按另一套命令运转。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
