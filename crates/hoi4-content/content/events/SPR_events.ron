                        AddToVariable(name: "spr_officer_conspiracy", value: -1.0),
                        ClampVariable(name: "spr_street_mobilization", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_government_authority", min: -10.0, max: 10.0),
                        ClampVariable(name: "spr_armory_control", min: -10.0, max: 10.0),
