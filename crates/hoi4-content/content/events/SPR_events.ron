                EventOption(
                    name: "监视莫拉的网络，等名单完整后再动手。",
                    effects: [
                        SetCountryFlag("spr_mola_network_monitored"),
                        AddPoliticalPower(10.0),
                        AddStability(-0.01),
                        AddToVariable(name: "spr_government_authority", value: 0.5),
