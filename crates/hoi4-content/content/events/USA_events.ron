                        AddGovernmentOrder(equipment_category: "convoy", daily_budget_rm: 400000.0, duration_days: 365),
                        SetCountryFlag("arsenal_of_democracy_active"),
                    ],
                ),
            ],
        ),
        Event(
            id: "usa.island_hopping_strategy",
            title: "Island Hopping Strategy",
