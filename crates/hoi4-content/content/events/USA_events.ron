EventDb(
    events: [
        Event(
            id: "usa.pearl_harbor_attacked",
            title: "Pearl Harbor Attacked",
            description: "Japanese aircraft have struck Pearl Harbor. The United States enters the war with overwhelming public support.",
            picture: "GFX_event_pearl_harbor",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "A day of infamy.",
                    effects: [
                        AddWarSupport(0.35),
                        AddStability(0.05),
                        AddPoliticalPower(100.0),
                        SetCountryFlag("pearl_harbor_attacked"),
                    ],
                ),
            ],
        ),
        Event(
