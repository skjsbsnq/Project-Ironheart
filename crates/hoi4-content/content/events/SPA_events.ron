                        AddStability(0.03),
                        AddPoliticalPower(-10.0),
                        AddToVariable(name: "spa_church_influence", value: 4.0),
                        AddToVariable(name: "spa_falange_power", value: -1.0),
                        AddToVariable(name: "spa_carlist_anger", value: -1.0),
                    ],
                    ai_chance: 0.6,
                ),
                EventOption(
