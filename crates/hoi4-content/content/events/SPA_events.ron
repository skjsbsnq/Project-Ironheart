        Event(
            id: "spa.scw_repression_after_victory",
            title: "责任名单",
            description: "内政处把各省送来的名单摊在长桌上：前市长、工会书记、教师、民兵军官、铁路工头、报纸编辑、曾给共和国仓库签过字的会计。白色恐怖在战争中已经有了自己的惯性，现在它要求被写成制度。军队希望用军法快速清场，长枪党希望把清洗变成地方组织权力，教会希望把惩罚和悔罪绑定，旧官僚则警告，如果每一座城都靠告密名单运转，税收和粮票会先崩。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
