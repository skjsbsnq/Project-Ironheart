                        AddToVariable(name: "spa_army_loyalty", value: -1.0),
                        AddToVariable(name: "spa_foreign_dependency", value: 1.0),
                        ClampVariable(name: "spa_franco_authority", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_army_loyalty", min: 0.0, max: 100.0),
