                        AddToVariable(name: "spa_army_loyalty", value: 1.0),
                        AddToVariable(name: "spa_postwar_debt_pressure", value: 4.0),
                        AddToVariable(name: "spa_demobilization_pressure", value: 2.0),
                        AddToVariable(name: "spa_occupation_resistance", value: 4.0),
