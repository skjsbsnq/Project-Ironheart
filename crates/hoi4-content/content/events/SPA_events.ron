                EventOption(name: "教会和地方精英接手救济与登记。", effects: [SetCountryFlag("spa_occupation_policy_church"), AddStability(0.02), AddToVariable(name: "spa_church_influence", value: 3.0), AddToVariable(name: "spa_falange_power", value: -1.0), TriggerEvent("hidden.scw_nationalist_occupation_order_tick")], ai_chance: 0.25),
                EventOption(name: "长枪党地方委员会接管清洗和配给。", effects: [SetCountryFlag("spa_occupation_policy_falange"), AddStability(-0.01), AddToVariable(name: "spa_falange_power", value: 3.0), AddToVariable(name: "spa_syndicalist_institutionalization", value: 1.0), TriggerEvent("hidden.scw_nationalist_occupation_order_tick")], ai_chance: 0.15),
            ],
