            immediate: [SetCountryFlag("spa_badajoz_aftermath_resolved")],
            options: [
                EventOption(name: "承认恐惧的用途，别追问执行细节。", effects: [SetCountryFlag("spa_badajoz_repression_public"), SetCountryFlag("spa_white_terror_expanded"), AddWarSupport(0.02), AddStability(-0.03), AddToVariable(name: "spa_occupation_resistance", value: 4.0), AddToVariable(name: "spa_international_outrage", value: 3.0), TriggerEvent("hidden.scw_nationalist_occupation_order_tick")], ai_chance: 0.5),
                EventOption(name: "把责任压回军法处，至少恢复表面纪律。", effects: [SetCountryFlag("spa_badajoz_discipline_review"), AddPoliticalPower(-10.0), AddToVariable(name: "spa_army_loyalty", value: 1.0), AddToVariable(name: "spa_occupation_resistance", value: 1.0), TriggerEvent("hidden.scw_nationalist_occupation_order_tick")], ai_chance: 0.5),
            ],
        ),
        Event(
            id: "spa.scw_yague_after_badajoz",
            title: "亚圭的军衔还挂在档案里",
            description: "军法处在巴达霍斯事件后，把所有相关军官的档案调出来重审了一遍。只有一个人的档案上没有任何书面处分记录：胡安·亚圭。不是因为他无辜，而是因为没有人能在报告里明确写下'亚圭下令'这四个字——每一道命令都是口头传达，每一名执行者都只说'收到了命令'而不说'收到了谁的命令'。这种含糊不是行政失误，是非洲军团在殖民地积累出来的老练：他们知道怎么写报告才能让上司永远找不到责任人。

佛朗哥的一名高级参谋私下告诉联络官：'亚圭不能调走。把他调走，非洲军团的军官团会认为总部在背叛前线。'另一个声音来自法务处：'不调走，国际红十字会的下一份报告会把国民军的名字和军事法庭绑在一起。'这两种恐惧——前线的士气和国际的舆论——互相挤压出同一个结论：不管怎么处置亚圭，都有人在等着一笔迟早要还的代价。",
            picture: "GFX_event_spanish_civil_war",
