                        ClampVariable(name: "spa_franco_authority", min: 0.0, max: 100.0),
                        TriggerEvent("spa.scw_sanjurjo_plane_crash"),
                    ],
                    ai_chance: 0.4,
                ),
                EventOption(
                    name: "让佛朗哥协调非洲军团与外援。",
