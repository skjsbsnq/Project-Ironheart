                        SetCountryFlag("spa_p9_weight_checked_caudillo"),
                        AddStability(0.01),
                        AddPoliticalPower(10.0),
                        AddToVariable(name: "spa_church_influence", value: 1.0),
                        AddToVariable(name: "spa_franco_authority", value: 1.0),
                        AddToVariable(name: "spa_carlist_anger", value: 1.0),
                    ],
                    ai_chance: 0.4,
                ),
            ],
        ),
        Event(
            id: "spa.scw_axis_or_neutrality",
            title: "胜利者和债主",
            description: "德国顾问离开前留下矿产清单，意大利代表留下燃油、炮弹和军费账目。外交部知道，西班牙没有力气立刻加入欧洲下一场战争；财政处也知道，拒绝所有索偿会让战时援助变成战后勒索。问题不在于是否欠债，而在于这份债务会被写成贸易、基地便利、外交靠拢，还是被拖进一份含糊的中立声明里。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "承认债务，用钨矿和采购合同还账。",
                    effects: [
                        SetCountryFlag("spa_postwar_axis_debt_acknowledged"),
                        SetCountryFlag("spa_p9_weight_axis_debt"),
                        If(trigger: HasGlobalFlag("ger_scw_air_war_laboratory_completed"), effects: [SetCountryFlag("spa_postwar_german_air_claims"), AddToVariable(name: "spa_foreign_dependency", value: 1.0)]),
                        If(trigger: HasGlobalFlag("ger_scw_condor_legion_returned_to_germany"), effects: [SetCountryFlag("spa_postwar_german_condor_claims"), AddToVariable(name: "spa_foreign_dependency", value: 1.0)]),
                        If(trigger: HasGlobalFlag("ita_scw_expanded_ctv_ready"), effects: [SetCountryFlag("spa_postwar_italian_ctv_claims"), AddToVariable(name: "spa_foreign_dependency", value: 1.0)]),
                        AddOpinion(target: "GER", amount: 15),
                        AddOpinion(target: "ITA", amount: 12),
                        AddTradeAgreement(partner: "GER", good_id: "tungsten", daily_quantity: 6.0),
                        AddTradeAgreement(partner: "ITA", good_id: "steel", daily_quantity: 4.0),
                        AddToVariable(name: "spa_postwar_debt_pressure", value: 3.0),
                        AddToVariable(name: "spa_foreign_dependency", value: 2.0),
                        TriggerEvent("ger.scw_claims_after_franco_victory"),
                        TriggerEvent("ita.scw_claims_after_franco_victory"),
                    ],
                    ai_chance: 0.55,
                ),
                EventOption(
                    name: "宣布谨慎中立，债务逐项谈判。",
                    effects: [
                        SetCountryFlag("spa_postwar_neutrality_declared"),
                        SetCountryFlag("spa_p9_weight_autonomous_victory"),
                        AddOpinion(target: "GER", amount: -8),
                        AddOpinion(target: "ITA", amount: -6),
                        AddStability(0.01),
                        AddToVariable(name: "spa_postwar_debt_pressure", value: 1.0),
                        AddToVariable(name: "spa_foreign_dependency", value: -2.0),
                        If(trigger: VariableAtLeast(name: "spa_foreign_dependency", value: 6.0), effects: [SetCountryFlag("spa_p9_risk_axis_claims"), TriggerEvent("ger.scw_claims_after_franco_victory"), TriggerEvent("ita.scw_claims_after_franco_victory")]),
                    ],
                    ai_chance: 0.45,
                ),
            ],
        ),
    ],
)
