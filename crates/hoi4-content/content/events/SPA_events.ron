        Event(
            id: "spa.scw_church_and_state",
            title: "钟声和课本",
            description: "战争结束后的第一个礼拜日，主教们要求的不只是感恩弥撒。教产、学校、婚姻登记、审查权、地方救济网络和战殁者纪念，都被放进同一份备忘录。国民军需要教会为胜利赋予意义，也需要国家机器保留最后裁决权。让教会重建社会秩序可以迅速填补被战争撕开的基层空洞，但每一间学校和每一本课本都会把战后国家推向更深的国民天主教。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
