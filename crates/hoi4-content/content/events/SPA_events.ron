        Event(
            id: "spa.scw_unification_decree_drafted",
            title: "一份被涂改了十二遍的草稿",
            description: "塞拉诺·苏涅尔在布尔戈斯法务处的一间小办公室里，用了一整夜起草统一法令的第七稿。每一稿都在试图把四样东西塞进同一个自然段：长枪党的国家工团主义纲领、卡洛斯派的天主教王政信仰、军政府的命令体系、以及旧保守派精英的行政经验。前面六稿没有一版能撑到第二天早上——不是红贝雷的人抗议'王位问题被降格为注脚'，就是蓝衫把'国家元首权力条款不足'的修订意见用红笔直接写满了页边。第七稿被改到凌晨三点，苏涅尔最终放弃了合并原则，改为合并名称——他创造了一个新词：'传统主义西班牙国家工团主义攻委会方阵'。这个词没人真正理解，所以每个人都能在它里面看见自己想看见的东西。佛朗哥看了一遍，批了两个字：'签字。'",
            picture: "GFX_event_spanish_civil_war",
            trigger: And([Tag("SPA"), HasCountryFlag("spa_falange_secretariat_resolved"), HasCountryFlag("spa_varela_fal_conde_resolved"), Not(HasCountryFlag("spa_unification_decree_drafted"))]),
            mean_time_to_happen_days: 10,
            immediate: [SetCountryFlag("spa_unification_decree_drafted")],
            options: [EventOption(name: "把草案送交考迪罗办公室。", effects: [AddPoliticalPower(-10.0), AddToVariable(name: "spa_franco_authority", value: 1.0), TriggerEvent("spa.scw_unification_decree")], ai_chance: 1.0)],
        ),
        Event(
            id: "spa.scw_unification_decree",
            title: "缝线",
            description: "法令公布那天，布尔戈斯下了一场雨。法务处的一等秘书把法令正文抄了三份——一份存档，一份送长枪党总部，一份张贴。每一份上，各派都能在字缝里读出不同的命运。卡洛斯派的代表发现'王位'这个词只出现在序言里，正文从未提过继承权——他们没被否定，但也没被承诺。蓝衫干部发现长枪党的二十六条纲领被简化为'引导原则'四个字，附在第三条末位——法律承认了他们的存在，但拒绝让他们的纲领变成国家的纲领。旧行政官们则发现新设立的国民运动中央书记处没有任何预算条款——他们的权力被体制化了，但体制没给他们钱。

佛朗哥在签字时只停了一次：他问法务官，法令第五条末尾那句'国家元首对运动之一切机构享有最终管辖权'能不能再写粗一点。法务官回答：'字不能变粗，但可以在这一条后面加一个单独的附录——列出所有受此条款管辖的机构名称。名单越长，管辖越实。'佛朗哥点点头，把笔蘸了墨。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(name: "强制统一，所有右翼都归入国民运动。", effects: [SetCountryFlag("spa_unification_decree_enforced"), SetCountryFlag("spa_p9_candidate_franco_victory"), AddToVariable(name: "spa_franco_authority", value: 4.0), AddToVariable(name: "spa_carlist_anger", value: 3.0), AddToVariable(name: "spa_falange_power", value: -1.0), TriggerEvent("spa.scw_hedilla_arrested")], ai_chance: 0.6),
                EventOption(name: "给长枪党秘书处保留谈判空间。", effects: [SetCountryFlag("spa_unification_decree_bargained"), AddToVariable(name: "spa_falange_power", value: 2.0), AddToVariable(name: "spa_franco_authority", value: 1.0), AddToVariable(name: "spa_carlist_anger", value: 2.0), TriggerEvent("spa.scw_hedilla_compromise")], ai_chance: 0.4),
            ],
        ),
        Event(id: "spa.scw_hedilla_arrested", title: "萨拉曼卡的凌晨三点", description: "宪兵队敲开赫迪利亚寓所时，他正在修改一份准备第二天送交佛朗哥的秘书处章程草案。逮捕令由佛朗哥亲自签署，罪名栏写的是'危害国民运动之统一'——一个刚刚被同一支笔在法律上创造出来的新罪名。赫迪利亚被带出房间时，把一份未完成的章程草案塞进大衣口袋。他在囚室里对后来被派来审问他的法务官说了一句话：'你们可以把我关起来，但你们没法把长枪党每一个地方委员会的印章都锁进抽屉。那些印章不在我手里，在每一个省的蓝衫地方组织手里。它们不需要我的命令才会盖下去。'这句话后来被写进了军事情报局的内部评估报告，附录标题是'长枪党基层失控风险评估'。", picture: "GFX_event_spanish_civil_war", is_triggered_only: true, trigger: AlwaysTrue, mean_time_to_happen_days: 1, options: [EventOption(name: "秘书处服从考迪罗。", effects: [SetCountryFlag("spa_hedilla_arrested"), ImprisonCharacter("spa_manuel_hedilla"), AddToVariable(name: "spa_franco_authority", value: 3.0), AddToVariable(name: "spa_falange_power", value: -2.0), AddToVariable(name: "spa_army_loyalty", value: 1.0), TriggerEvent("hidden.scw_nationalist_internal_pressure_tick")], ai_chance: 1.0)]),
        Event(id: "spa.scw_hedilla_compromise", title: "妥协的墨迹还没干", description: "赫迪利亚在被正式签署逮捕令之前，得到了塞拉诺·苏涅尔连夜传达的另一个选择：放弃公开对抗统一法令，接受佛朗哥对国民运动的最高领导权，作为交换——赫迪利亚个人不被起诉，长枪党秘书处的原有编制得到临时保留权，各省地方委员会的印章继续由蓝衫组织自行管理。赫迪利亚签了。签完之后他对法务官说：'今天佛朗哥赢了名字，十年后我们会赢回来所有他用名字控制的东西——因为名字会变老，但制度会习惯我们。'" , picture: "GFX_event_spanish_civil_war", is_triggered_only: true, trigger: AlwaysTrue, mean_time_to_happen_days: 1, options: [EventOption(name: "让赫迪利亚以服从换取秘书处席位。", effects: [SetCountryFlag("spa_hedilla_compromise_reached"), SetCountryFlag("spa_p9_candidate_falange_bargain"), AddToVariable(name: "spa_falange_power", value: 3.0), AddToVariable(name: "spa_syndicalist_institutionalization", value: 2.0), AddToVariable(name: "spa_franco_authority", value: 1.0), TriggerEvent("hidden.scw_nationalist_internal_pressure_tick")], ai_chance: 1.0)]),
        Event(
            id: "spa.scw_caudillo_or_revolution",
            title: "考迪罗还是运动",
            description: "统一法令实施后，佛朗哥在考迪罗办公室召见了塞拉诺·苏涅尔和长枪党秘书处剩余的三名高级干部。房间里没有别人。佛朗哥把两份文件并排摊在桌上——左边是军队指挥系统树状图，右边是国民运动组织架构草案。他用手指点着两张纸中间的那个空档说：'这里需要一个方向。'

方向只有两个。第一个：佛朗哥宣布他是所有派系的最终仲裁者——长枪党只是运动的装饰品，军队才是国家的脊梁，一切由考迪罗签字。这条路通往个人独裁。第二个：长枪党秘书处被授权将国民运动的地方委员会系统扩展到每一个省、每一座城、每一个镇——以'运动'的名义逐步蚕食行政岗位，佛朗哥仍然是元首，但执行元首意志的人全是蓝衫。这条路通往党国。

苏涅尔提醒佛朗哥：'如果您选第二条，二十年后您仍然是考迪罗，但决定谁继承您的人将是长枪党的书记处，不是您的继承人。'佛朗哥沉默了很久，最后说了一句话：'制度可以被习惯磨损。但一个人的签字，只有死亡才能让它失效。'",
            picture: "GFX_event_spanish_civil_war",
            trigger: And([Tag("SPA"), Or([HasCountryFlag("spa_hedilla_arrested"), HasCountryFlag("spa_hedilla_compromise_reached")]), Not(HasCountryFlag("spa_caudillo_or_revolution_resolved"))]),
            mean_time_to_happen_days: 12,
            immediate: [SetCountryFlag("spa_caudillo_or_revolution_resolved")],
            options: [
                EventOption(name: "考迪罗仲裁一切。", effects: [SetCountryFlag("spa_caudillo_above_movement"), AddToVariable(name: "spa_franco_authority", value: 4.0), AddToVariable(name: "spa_syndicalist_institutionalization", value: -1.0), TriggerEvent("spa.scw_franco_caudillo")], ai_chance: 0.65),
                EventOption(name: "让国民运动成为国家的骨架。", effects: [SetCountryFlag("spa_movement_state_skeleton"), AddToVariable(name: "spa_falange_power", value: 3.0), AddToVariable(name: "spa_syndicalist_institutionalization", value: 3.0), AddToVariable(name: "spa_army_loyalty", value: -1.0), TriggerEvent("spa.scw_franco_caudillo")], ai_chance: 0.35),
            ],
        ),
        Event(id: "spa.scw_franco_caudillo", title: "考迪罗", description: "布尔戈斯大教堂偏厅被临时改为授衔仪式现场。站在佛朗哥身后的不是军政府全体委员，而是被精心挑选过的象征物——一名主教、一名蓝衫省干部、一名旧行政官、三名军区将领。每一个被选入镜头的人，都代表一个佛朗哥需要暂时安抚的力量。摄像机拍下了佛朗哥接受军刀和印章的画面，但没有拍到仪式开始前的一小时，他在更衣室里看着镜中的自己，对侍从官说了一句话：'我今天接过来的不是西班牙。是西班牙所有还没打完的内战。'他说得没错。这间屋子里没有一个人完全忠于他。主教忠于圣座，蓝衫忠于已死的何塞·安东尼奥，旧行政官忠于可执行的账簿，将领忠于各自的军区网络。佛朗哥签字成为西班牙的考迪罗，但他继承的不是一个被征服的国家，而是一团由妥协、恐惧、债务和未完成承诺暂时捏合在一起的泥土。他要在接下来几十年里，把这团泥土烧成砖，然后一块一块地建造一座没有人敢拆的纪念碑。", picture: "GFX_event_spanish_civil_war", is_triggered_only: true, trigger: AlwaysTrue, mean_time_to_happen_days: 1, options: [EventOption(name: "西班牙现在有了考迪罗。", effects: [SetCountryFlag("spa_franco_caudillo_proclaimed"), SetLeader("spa_francisco_franco"), AddWarSupport(0.03), AddToVariable(name: "spa_franco_authority", value: 5.0), TriggerEvent("spa.scw_kindelan_questions_the_caudillo"), TriggerEvent("hidden.scw_nationalist_internal_pressure_tick")], ai_chance: 1.0)]),
        Event(
            id: "spa.scw_kindelan_questions_the_caudillo",
            title: "王位问题",
            description: "阿尔弗雷多·金德兰是国民军空军司令、坚定的君主主义者，也是少数敢于在正式场合向佛朗哥提问题的人。仪式结束后，他在走廊里拦住了刚刚接受'考迪罗'头衔的佛朗哥，没有用敬语：'将军，您现在拥有了这个国家。告诉我，您打算什么时候把它还给国王？'

这个问题在军事委员会内部已经私下讨论了无数次。金德兰代表的不是自己，而是整批传统君主派将领——他们接受佛朗哥作为战争领袖，但不接受佛朗哥作为王朝的替代品。佛朗哥可以立刻给出一份关于战后君主制恢复的时间表，但那意味着他在自己的权威之上安置了一个比他更高的法律存在。他也可以告诉金德兰：西班牙现在需要秩序，不是王冠，王位是未来的事，不是今天的事——这句话等于在说：我死之后，再说国王。

侍从官后来在日记里写道，佛朗哥听完问题后在走廊里站了很长一段时间，最后用一个所有人都无法反驳的逻辑结束了对话：'国王回来需要宪法，宪法需要起草，起草需要和平，和平需要我赢。等我赢之后，我们再来讨论宪法。'他把王位问题拖进了战争的后半段，然后用'战后再说'四个字，把君主派将领的不满转换成了一种可以被时间稀释的等待。",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(name: "承诺战后讨论王政，先保住军内体面。", effects: [SetCountryFlag("spa_kindelan_royal_question_deferred"), AddToVariable(name: "spa_army_loyalty", value: 2.0), AddToVariable(name: "spa_franco_authority", value: -1.0), TriggerEvent("hidden.scw_nationalist_internal_pressure_tick")], ai_chance: 0.45),
                EventOption(name: "让金德兰明白：胜利者不会被旧王位裁决。", effects: [SetCountryFlag("spa_kindelan_royal_question_rebuffed"), SetCountryFlag("spa_p9_risk_royalist_distrust"), AddToVariable(name: "spa_franco_authority", value: 2.0), AddToVariable(name: "spa_army_loyalty", value: -2.0), TriggerEvent("hidden.scw_nationalist_internal_pressure_tick")], ai_chance: 0.55),
            ],
        ),
        Event(
            id: "spa.scw_victory",
            title: "胜利日的账本",
            description: "马德里的电台先读出停火命令，随后读出胜利宣言。布尔戈斯参谋部没有立刻欢呼，秘书们忙着把三种名单分开装订：投降部队登记、政治责任审查、外援债务凭据。前线军官要求复员，长枪党地方委员会要求接管街区，主教们要求重开学校和教产登记，德国与意大利顾问则提醒财政处，援助从来不是礼物。战争结束了，但胜利者还没有决定战后的国家究竟由军队、教会、党部、考迪罗，还是债主来书写。第一份和平命令必须同时回答所有人。",
