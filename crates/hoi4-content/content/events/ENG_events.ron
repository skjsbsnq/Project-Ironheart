EventDb(
    events: [
        Event(
            id: "england.poland_guarantee_hardened",
            title: "Guarantee to Poland Reaffirmed",
            description: "German pressure on Danzig has ended the policy of appeasement. The Cabinet confirms that Britain will stand by Poland if war comes.",
            picture: "GFX_event_uk_guarantee",
            trigger: Date(year: 1939, month: 3, day: 31),
