EventDb(
    events: [
        Event(
            id: "news.scw_outbreak",
            title: "西班牙内战爆发",
            description: "从梅利利亚到塞维利亚，叛乱军官的电报在夜色中穿过海峡；马德里电台仍以共和国政府的名义呼吁服从，工会会所却已经排起领取步枪的队伍。欧洲各国报纸把西班牙称作一场国内危机，但使馆人员、军火商和流亡者都明白，这场战争会把整个大陆的恐惧拖进伊比利亚。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "西班牙裂成两半。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_nationalist_victory",
            title: "国民军宣称赢得西班牙战争",
            description: "最后的共和国据点放下武器后，国民军电台宣布战争结束。教堂钟声、阅兵口令和监狱登记册同时响起；佛朗哥、军政府、长枪党、教会和外国债主都准备从胜利中索取自己的份额。西班牙重新统一，但这个国家首先要学习如何在胜利者的清算中呼吸。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "胜利带来的账单开始到期。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_republican_victory",
            title: "共和国守住西班牙",
            description: "叛乱军队的最后指挥部停止抵抗，马德里以共和国政府的名义宣布战争结束。广场上有人欢呼，也有人盯着空弹壳、临时墓地和写满派系名字的墙壁。共和国仍然存在，但它已经被民兵、苏联顾问、地方委员会和战争经济改变；和平不会自动回答谁有权代表这场胜利。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "共和国活了下来，但代价还在。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_madrid_under_siege",
            title: "马德里进入围城",
            description: "通往马德里的公路被检查站、炮兵观察哨和撤退下来的卡车挤满。政府仍在电台里喊出“他们不得通过”，但电话总局的接线员已经学会先问对方在哪一条街、哪一座桥、哪一个仓库。使馆区的窗帘整夜亮着，记者把打字机搬进地下室，面包房门口的队伍比征兵处更长。首都还没有陷落，但所有人都听见了围城的声音：不是一声炮响，而是每一天少一列火车、少一袋面粉、少一条可以相信的命令。",
            picture: "GFX_event_madrid",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "马德里开始用街垒计时。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_madrid_falls",
            title: "马德里陷落",
            description: "马德里的街垒在炮火、饥饿和连续撤退中崩塌。政府档案被匆忙装箱，留下的市政职员在地下室清点伤员和粮票；国民军纵队进入首都时，胜利游行后面跟着军法处、告密名单和寻找亲人的人群。西班牙战争没有因此变得干净，只是换了一种秩序。对国民军而言，首都成为考迪罗权威最响亮的证词；对共和国而言，马德里变成一张必须在流亡、迁都和最后抵抗之间反复解释的欠条。",
            picture: "GFX_event_madrid_falls",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "首都的沉默传遍欧洲。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_guernica_bombed",
            title: "格尔尼卡遭到轰炸",
            description: "巴斯克小城格尔尼卡的名字在一天之内越过比利牛斯山。记者写下集市、钟楼、燃烧的木梁和找不到亲人的街道；外交官则在电报里使用更冷的词：空中志愿军、目标选择、德国飞机。国民军称这是军事行动，共和国称这是屠杀，柏林称没有德国部队参战。欧洲各国报纸第一次看见一种未来战争的轮廓：城市不再只是被占领，它们可以先被天空审判。",
            picture: "GFX_event_guernica",
            scope: News,
            trigger: HasGlobalFlag("news_scw_guernica_bombed_ready"),
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "西班牙的天空不再属于西班牙。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_bilbao_falls",
            title: "毕尔巴鄂陷落",
            description: "毕尔巴鄂的工厂烟囱没有立刻熄灭，最先停下的是共和国账簿里的北方工业数字。矿区、铁路调度室和港口仓库被国民军军需官逐项登记，巴斯克政府的文件箱则沿着山路向西撤退。德国顾问在报告里写下钢铁、装卸能力和空袭效果，布尔戈斯的宣传部写下统一与秩序；被夹在两份文件之间的，是失去后方的共和国北方军。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "北方工业肺叶被夺走。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_northern_front_collapses",
            title: "共和国北方战线崩溃",
            description: "从桑坦德到阿斯图里亚斯，北方战线在煤矿、雨水和被切断的铁路之间一段段塌陷。矿工纵队把最后的弹药从井口搬上卡车，港口工人把无法带走的机器零件推入仓库深处，撤退命令常常比国民军先到半天，也常常晚到半天。对共和国来说，北方的丧失意味着钢铁、煤、港口和一支独立抵抗力量同时从地图上被擦去；对国民军来说，这是一份会在战后被外援债主翻出来的资产清单。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "北方不再替共和国呼吸。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_ebro_battle",
            title: "埃布罗河畔的最后赌博",
            description: "共和国把仍能调动的师、桥梁材料、国际纵队残部和政治希望推向埃布罗河。渡河命令像一份赌约：只要能打乱国民军节奏，马德里和巴塞罗那或许还能多得到一个冬天；若失败，损失的不只是士兵，而是共和国证明自己还会进攻的最后机会。河岸上堆着湿透的绷带、坏掉的电话线和无人承认的撤退路线，欧洲报纸把它称作战役，前线军官则知道这更像一次用国家余烬点燃的信号。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "共和国把余火押上河岸。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_barcelona_falls",
            title: "巴塞罗那陷落",
            description: "加泰罗尼亚的港口和工厂落入国民军手中。通往法国边境的道路挤满难民、卡车、儿童和被抛弃的机器零件；工会旗帜被从厂房上扯下，新的军政官开始登记仓库、铁路和码头。对共和国而言，巴塞罗那的陷落不是一座城市的丧失，而是最后工业后方的熄灭。对国民军而言，这座城市也不是单纯的战利品：它带来港口、兵工厂、难民、地下组织和一整套需要在胜利后清算的革命记忆。",
            picture: "GFX_event_barcelona_falls",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "共和国的退路越来越窄。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.scw_foreign_volunteers_questioned",
            title: "外国志愿军问题搅动伦敦与巴黎",
            description: "不干涉委员会的桌面上堆满了互相矛盾的报告：意大利志愿军的整建制番号、德国飞机的零件编号、葡萄牙边境的无牌卡车、苏联顾问在共和国港口卸下的木箱。每个政府都声称自己没有参战，每个使馆都知道这句话不完整。西班牙内战正在变成一场欧洲国家用否认书签署的战争。",
            picture: "GFX_event_spanish_civil_war",
            scope: News,
            trigger: HasGlobalFlag("news_scw_foreign_volunteers_questioned_ready"),
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "不干涉开始有了火药味。", effects: [], ai_chance: 1.0)],
        ),
    ],
)
