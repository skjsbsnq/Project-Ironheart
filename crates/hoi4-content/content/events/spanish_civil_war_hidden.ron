        Event(
            id: "hidden.scw_cnt_uprising_check",
            title: "检查 CNT 和 POUM 压力",
            description: "",
            picture: "",
            is_triggered_only: true,
            hidden: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "汇总 CNT 和 POUM 风险。",
                    effects: [
                        If(
                            trigger: HasCountryFlag("cnt_collectivization_recognized"),
                            effects: [
                                SetCountryFlag("spr_cnt_collectivization_memory"),
                                AddToVariable(name: "spr_revolutionary_pressure", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("cnt_factory_committees_supervised"),
                            effects: [
                                SetCountryFlag("spr_cnt_factory_supervision_grievance"),
                                AddToVariable(name: "spr_military_centralization", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("cnt_refused_integration"),
                            effects: [
                                SetCountryFlag("spr_cnt_may_days_risk"),
                                SetCountryFlag("spr_nationalist_propaganda_red_militias"),
                                AddToVariable(name: "spr_revolutionary_pressure", value: 2.0),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("cnt_militias_integrated"),
                            effects: [
                                SetCountryFlag("cnt_militias_integrated"),
                                AddToVariable(name: "spr_military_centralization", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("poum_outlawed"),
                            effects: [
                                SetCountryFlag("spr_cnt_may_days_risk"),
                                SetCountryFlag("spr_poum_repression_memory"),
                                SetCountryFlag("spr_nationalist_propaganda_red_purge"),
                                AddToVariable(name: "spr_revolutionary_pressure", value: 2.0),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("poum_protected"),
                            effects: [
                                SetCountryFlag("spr_poum_legal_memory"),
                                AddToVariable(name: "spr_soviet_influence", value: -1.0),
                            ],
                        ),
                        If(
                            trigger: And([
                                Date(year: 1937, month: 4, day: 15),
                                HasCountryFlag("spr_cnt_may_days_risk"),
                                Or([
                                    HasCountryFlag("poum_outlawed"),
                                    HasCountryFlag("spr_soviet_influence_high"),
                                    HasCountryFlag("spr_militias_forced_into_discipline"),
                                    VariableAtLeast(name: "spr_revolutionary_pressure", value: 16.0),
                                ]),
                                Not(HasCountryFlag("barcelona_may_days_triggered")),
                                Not(HasCountryFlag("cnt_uprising_prevented")),
                                Not(HasCountryFlag("spr_barcelona_telephone_exchange_crisis")),
                            ]),
                            effects: [
                                SetCountryFlag("spr_cnt_uprising_pressure_high"),
                                TriggerEvent("spr.scw_barcelona_telephone_exchange"),
                            ],
                        ),
                        If(
                            trigger: And([
                                Or([
                                    HasCountryFlag("spr_cnt_relationship_preserved"),
                                    HasCountryFlag("cnt_militias_integrated"),
                                    HasCountryFlag("poum_protected"),
                                ]),
                                Not(HasCountryFlag("barcelona_may_days_triggered")),
                                Not(HasCountryFlag("spr_cnt_uprising_pressure_high")),
                            ]),
                            effects: [
                                SetCountryFlag("cnt_uprising_prevented"),
                            ],
                        ),
                        ClampVariable(name: "spr_revolutionary_pressure", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_military_centralization", min: 0.0, max: 100.0),
                        ClampVariable(name: "spr_soviet_influence", min: 0.0, max: 100.0),
                    ],
                    ai_chance: 1.0,
                ),
            ],
        ),
