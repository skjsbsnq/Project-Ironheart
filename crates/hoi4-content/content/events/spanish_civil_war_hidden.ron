        Event(
            id: "hidden.scw_route_nationalist_victory",
            title: "国民军胜利路线分流",
            description: "",
            picture: "",
            is_triggered_only: true,
            hidden: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "结算国民军战后路线。",
                    effects: [
                        SetCountryFlag("spa_p9_route_evaluation_started"),
                        TriggerEvent("hidden.scw_nationalist_internal_pressure_tick"),
                        If(
                            trigger: Or([
                                HasCountryFlag("spa_hedilla_arrested"),
                                HasCountryFlag("spa_franco_caudillo_proclaimed"),
                                HasCountryFlag("spa_p9_candidate_franco_victory"),
                                VariableAtLeast(name: "spa_franco_authority", value: 12.0),
                            ]),
                            effects: [
                                SetCountryFlag("spa_p9_route_franco_victory"),
                                SetCountryFlag("spa_p9_route_decided"),
                                AddToVariable(name: "spa_franco_authority", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: And([
                                Not(HasCountryFlag("spa_p9_route_decided")),
                                Or([
                                    HasCountryFlag("spa_falange_secretariat_ascendant"),
                                    HasCountryFlag("spa_p9_candidate_falange_victory"),
                                    And([
                                        VariableAtLeast(name: "spa_falange_power", value: 9.0),
                                        VariableAtMost(name: "spa_army_loyalty", value: 6.0),
                                    ]),
                                ]),
                            ]),
                            effects: [
                                SetCountryFlag("spa_p9_route_falange_victory"),
                                SetCountryFlag("spa_p9_route_decided"),
                                AddToVariable(name: "spa_falange_power", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: And([
                                Not(HasCountryFlag("spa_p9_route_decided")),
                                Or([
                                    HasCountryFlag("spa_hedilla_compromise_reached"),
                                    HasCountryFlag("spa_p9_candidate_falange_bargain"),
                                    HasCountryFlag("spa_p9_candidate_institutionalized_syndicalism"),
                                    VariableAtLeast(name: "spa_syndicalist_institutionalization", value: 6.0),
                                ]),
                            ]),
                            effects: [
                                SetCountryFlag("spa_p9_route_institutionalized_syndicalism"),
                                SetCountryFlag("spa_p9_route_decided"),
                                AddToVariable(name: "spa_syndicalist_institutionalization", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: And([
                                Not(HasCountryFlag("spa_p9_route_decided")),
                                Or([
                                    HasCountryFlag("spa_p9_candidate_national_catholic_compromise"),
                                    HasCountryFlag("spa_p9_weight_checked_caudillo"),
                                    VariableAtLeast(name: "spa_church_influence", value: 8.0),
                                    VariableAtLeast(name: "spa_carlist_anger", value: 8.0),
                                ]),
                            ]),
                            effects: [
                                SetCountryFlag("spa_p9_route_national_catholic_compromise"),
                                SetCountryFlag("spa_p9_route_decided"),
                                AddToVariable(name: "spa_church_influence", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: Not(HasCountryFlag("spa_p9_route_decided")),
                            effects: [
                                SetCountryFlag("spa_p9_route_checked_franco_state"),
                                SetCountryFlag("spa_p9_route_decided"),
                                AddToVariable(name: "spa_junta_legitimacy", value: 1.0),
                            ],
                        ),
                        If(
                            trigger: VariableAtLeast(name: "spa_foreign_dependency", value: 8.0),
                            effects: [
                                SetCountryFlag("spa_p9_route_axis_debt_overhang"),
                                SetCountryFlag("spa_p9_risk_axis_claims"),
                            ],
                        ),
                        If(
                            trigger: HasCountryFlag("spa_white_terror_expanded"),
                            effects: [
                                SetCountryFlag("spa_p9_route_repression_state_memory"),
                                AddToVariable(name: "spa_occupation_resistance", value: 1.0),
                            ],
                        ),
                        ClampVariable(name: "spa_franco_authority", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_falange_power", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_army_loyalty", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_church_influence", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_carlist_anger", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_foreign_dependency", min: 0.0, max: 100.0),
                        ClampVariable(name: "spa_occupation_resistance", min: 0.0, max: 100.0),
                    ],
                    ai_chance: 1.0,
                ),
            ],
        ),
    ],
)
