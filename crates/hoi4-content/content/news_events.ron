// J.5b Part 3: News events for Italo-Ethiopian War milestones.
//
// These are `scope: News` events — all countries see them as newspaper-style popups.
// Triggered by SituationEffect::TriggerEvent from situation milestone/on_end effects.

EventDb(
    events: [
        // ═════════════════════════════════════════════════════════════════
        // Italo-Ethiopian War news events
        // ═════════════════════════════════════════════════════════════════
        Event(
            id: "news.eth_mustard_gas",
            title: "意大利在埃塞俄比亚使用芥子气！",
            description: "前线报告证实，意大利军队已对埃塞俄比亚士兵和平民使用芥子气。国际联盟谴责这一行动，却没有采取任何真正有效的措施。海尔·塞拉西向世界发出呼吁，但回声仍然空洞。",
            picture: "GFX_event_mustard_gas",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "现代战争的恐怖。",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),

        Event(
            id: "news.eth_addis_ababa_threatened",
            title: "Addis Ababa Under Threat!",
            description: "Italian forces are closing in on the Ethiopian capital. Imperial Guard units mount a desperate last defence. The fall of the city — and with it, Ethiopia — seems imminent.",
            picture: "GFX_event_addis_ababa",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "An ancient empire crumbles.",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),

        Event(
            id: "news.eth_selassie_exile",
            title: "Emperor Haile Selassie Goes Into Exile!",
            description: "The Emperor of Ethiopia has fled the country, seeking refuge in British Palestine. His speech to the League of Nations will echo through history. Ethiopia fights on without its leader.",
            picture: "GFX_event_selassie_exile",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "A emperor without a country.",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),

        Event(
            id: "news.eth_italy_victory",
            title: "Italy Conquers Ethiopia — Italian East Africa Established!",
            description: "Mussolini proclaims the birth of Italian East Africa. The Ethiopian Empire — one of the oldest in the world — is no more. The League of Nations is humiliated. A new colonial order takes shape in the Horn of Africa.",
            picture: "GFX_event_italy_ethiopia",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "The coloniser's triumph.",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),

        Event(
            id: "news.eth_italy_defeat",
            title: "Ethiopia Repels Italian Invasion!",
            description: "In a stunning upset, Ethiopian forces have repelled the Italian invasion. Mussolini's prestige lies in ruins. The League of Nations celebrates the first successful resistance to colonial aggression in Africa. Italy's military credibility is shattered.",
            picture: "GFX_event_ethiopia_victory",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Africa resists!",
                    effects: [],
                    ai_chance: 1.0,
                ),
            ],
        ),

        // Second Sino-Japanese War news events.
        Event(
            id: "news.marco_polo_bridge_incident",
            title: "卢沟桥事变",
            description: "北平郊外卢沟桥附近爆发交火。原本的局部冲突迅速扩大，日本与中国之间的全面战争已经爆发。",
            picture: "GFX_event_marco_polo_bridge",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "战争已经开始。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_shanghai",
            title: "淞沪会战爆发",
            description: "中日两军在上海周边陷入激烈城市战。战火已经从华北蔓延至长江下游。",
            picture: "GFX_event_shanghai_battle",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "战火正在扩大。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_nanjing",
            title: "南京告急",
            description: "日军纵队正向中国首都推进。国民政府准备紧急措施，平民开始向内地撤离。",
            picture: "GFX_event_nanjing",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "中国面临严峻考验。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_wuhan",
            title: "战火逼近武汉",
            description: "围绕武汉的中部战场不断升温。中国军队以空间换取时间，工业与政府机关继续向西转移。",
            picture: "GFX_event_wuhan",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "内地成为新的战场。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_chongqing_bombing",
            title: "重庆遭到轰炸",
            description: "随着中国在西南继续坚持抗战，日军空袭重庆，企图打击民心并切断政府与后方工业基地的联系。",
            picture: "GFX_event_chongqing_bombing",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "四川上空燃起战火。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.china_stabilizes_front",
            title: "中国战线趋于稳定",
            description: "尽管损失惨重，中国军队已经迟滞日本推进。地方军、共产党部队与中央政府共同维持一条脆弱的防线。",
            picture: "GFX_event_chinese_defense",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "抵抗正在加强。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_japanese_victory",
            title: "日本宣称在中国取胜",
            description: "日本宣称已经击溃中国有组织抵抗，并将在东亚建立新秩序。然而占领与治安的代价才刚刚开始显现。",
            picture: "GFX_event_japanese_victory_china",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "东亚被武力重塑。", effects: [], ai_chance: 1.0)],
        ),

        Event(
            id: "news.sino_japanese_war_chinese_victory",
            title: "中国赢得抗战胜利",
            description: "经过多年牺牲，中国终于挺过日本侵略。统一战线随即面临胜利之后中国将走向何方的问题。",
            picture: "GFX_event_chinese_victory",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "这是代价沉重的胜利。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.fall_of_beiping_tianjin",
            title: "平津陷落",
            description: "日军攻占平津地区，华北战局急转直下。中国守军被迫向内线撤退，山西与冀南方向压力骤增。",
            picture: "GFX_event_marco_polo_bridge",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "华北局势恶化。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.battle_of_taiyuan",
            title: "太原会战",
            description: "日军向山西纵深推进，太原周边爆发大规模会战。中国军队试图凭借山地与纵深迟滞攻势。",
            picture: "GFX_event_chinese_defense",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "山西战事扩大。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.jinan_under_threat",
            title: "济南告急",
            description: "日军已经迫近山东腹地，济南方向承受直接压力。山东战场可能成为华北与华东之间的新突破口。",
            picture: "GFX_event_chinese_defense",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "山东战局紧张。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.fall_of_jinan",
            title: "济南陷落",
            description: "济南防线被突破，日军控制山东主要交通节点。胶济线与津浦线方向的压力进一步增大。",
            picture: "GFX_event_chinese_defense",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "山东门户失守。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.qingdao_landing_or_pressure",
            title: "青岛方向战事扩大",
            description: "青岛与胶东方向战事升温，山东沿海与内陆防线同时承压。",
            picture: "GFX_event_shanghai_battle",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "胶东形势吃紧。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.battle_of_shanghai_begins",
            title: "淞沪会战爆发",
            description: "上海方向战事扩大，中日两军在长江下游投入重兵。中国希望以持久抵抗争取国际关注与全国动员时间。",
            picture: "GFX_event_shanghai_battle",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "上海成为焦点。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.shanghai_falls",
            title: "上海陷落",
            description: "上海核心城区落入日军控制，长江下游门户被打开。南京方向随即面临更直接的威胁。",
            picture: "GFX_event_shanghai_battle",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "长江门户失守。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.nanjing_under_threat",
            title: "南京告急",
            description: "日军已经突破长江下游外围，南京首都圈面临直接威胁。政府机关与平民开始紧急撤离。",
            picture: "GFX_event_nanjing",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [EventOption(name: "首都危在旦夕。", effects: [], ai_chance: 1.0)],
        ),
        Event(
            id: "news.fall_of_nanjing",
            title: "南京陷落",
            description: "南京防线被突破，日军进入中国首都。中国政府被迫继续向内地组织持久抗战。",
            picture: "GFX_event_nanjing",
            scope: News,
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
