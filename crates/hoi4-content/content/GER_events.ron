            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Approve the outrage.",
                    effects: [
                        AddStability(-0.05),
                        AddOpinion(target: "USA", amount: -25),
                        AddOpinion(target: "ENG", amount: -15),
                        AddNamedThreat(2.0),
                        SetCountryFlag("kristallnacht"),
