        Event(
            id: "ger.scw_condor_legion",
            title: "秃鹰军团飞往西班牙",
            description: "空军部把这批飞机、飞行员和技师登记为'技术试验部署'。这个词足够干净，可以给外交部；也足够模糊，可以给总参谋部。容克运输机、轰炸机备件、无线电和少量坦克顾问会从德国港口进入西班牙国民军控制区，换回的不是一句感谢，而是空战数据、军官履历、矿产承诺和战后采购期待。柏林不会把援助写成礼物。每一架飞机都有编号，每一箱燃油都有账页。",
            picture: "GFX_event_condor_legion",
            trigger: And([
                Tag("GER"),
                CountryExists("SPA"),
                Date(year: 1936, month: 8, day: 1),
                Not(HasCountryFlag("ger_scw_condor_legion_sent")),
            ]),
            mean_time_to_happen_days: 5,
            immediate: [SetCountryFlag("ger_scw_condor_legion_sent")],
            options: [
                EventOption(
                    name: "派出秃鹰军团，记录所有战后索偿凭据。",
                    effects: [
                        SetCountryFlag("condor_legion_active"),
                        SetCountryFlag("ger_scw_spanish_debt_ledger_opened"),
                        SetGlobalFlag("ger_scw_condor_legion_sent_to_spain"),
                        AirExperience(8.0),
                        AddOpinion(target: "SPA", amount: 20),
                        AddNamedThreat(0.5),
                    ],
                    ai_chance: 0.85,
                ),
                EventOption(
                    name: "只卖设备，不派成建制人员。",
                    effects: [
                        SetCountryFlag("ger_scw_limited_aircraft_sales"),
                        AddPoliticalPower(15.0),
                        AddOpinion(target: "SPA", amount: 8),
                    ],
                    ai_chance: 0.15,
                ),
            ],
        ),
        Event(
            id: "ger.scw_air_war_laboratory",
            title: "把天空当作实验室",
            description: "西班牙北方传来的照片被送进柏林会议室：铁路线、桥梁、市镇广场、烟柱和防空火力位置。空军参谋不把这些照片称为城市，也不称为家园；他们称之为目标类型。轰炸机编队需要练习，战术学校需要数据，德国工业需要知道新型炸弹在真实街区中的效果。外交官提醒众人，若照片被英国报纸拿到，'志愿'二字会变得很薄。戈林只问了一句：数据是否足够清楚。",
            picture: "GFX_event_guernica",
            trigger: And([
                Tag("GER"),
                CountryExists("SPA"),
                HasCountryFlag("ger_scw_condor_legion_sent"),
                Date(year: 1937, month: 4, day: 26),
                Not(HasCountryFlag("ger_scw_air_war_laboratory_run")),
            ]),
            mean_time_to_happen_days: 1,
            immediate: [SetCountryFlag("ger_scw_air_war_laboratory_run")],
            options: [
                EventOption(
                    name: "把战术数据带回柏林。",
                    effects: [
                        SetCountryFlag("ger_scw_guernica_lessons_taken"),
                        SetGlobalFlag("ger_scw_air_war_laboratory_completed"),
                        SetGlobalFlag("news_scw_guernica_bombed_ready"),
                        AirExperience(20.0),
                        AddTechBonus(category: "air_doctrine", bonus: 0.25),
                        AddNamedThreat(1.5),
                    ],
                    ai_chance: 1.0,
                ),
            ],
        ),
        Event(
            id: "ger.scw_condor_legion_returns",
            title: "秃鹰军团归国",
            description: "归国仪式上，飞行员得到鲜花，参谋得到报告，企业代表得到一叠更有价值的东西：西班牙前线验证过的故障记录、机场维护清单、弹药消耗表，以及布尔戈斯对未来采购和矿产供应的含糊承诺。德国把这些人称为志愿者，但他们带回来的经验会进入学校、工厂和下一场战争的计划书。西班牙得到的则是一份没有明确到期日的账单。",
            picture: "GFX_event_condor_return",
            trigger: And([
                Tag("GER"),
                HasCountryFlag("ger_scw_condor_legion_sent"),
                Date(year: 1939, month: 5, day: 23),
                Not(HasCountryFlag("ger_scw_condor_legion_returned")),
            ]),
            mean_time_to_happen_days: 1,
            immediate: [SetCountryFlag("ger_scw_condor_legion_returned")],
            options: [
                EventOption(
                    name: "把西班牙经验写进德国条令。",
                    effects: [
                        ClearCountryFlag("condor_legion_active"),
                        SetGlobalFlag("ger_scw_condor_legion_returned_to_germany"),
                        AirExperience(25.0),
                        ArmyExperience(10.0),
                        AddTechBonus(category: "air_doctrine", bonus: 0.20),
                    ],
                    ai_chance: 1.0,
                ),
            ],
        ),
        Event(
            id: "ger.scw_claims_after_franco_victory",
            title: "马德里的账单",
            description: "西班牙胜利的消息抵达柏林时，空军、外交部和经济部门递上了三份不同的清单。空军要求把西班牙经验写进条令，经济部门要求钨矿、采购合同和还款安排，外交部则希望佛朗哥至少在公开场合承认德国援助的决定性作用。内战中的'志愿'现在变成了正式账目。西班牙太虚弱，无法立即成为可靠盟友；也正因为虚弱，它必须学会先偿还帮助它获胜的人。",
            picture: "GFX_event_condor_return",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "索取矿产、订单和外交靠拢。",
                    effects: [
                        SetCountryFlag("ger_scw_claims_after_franco_victory"),
                        SetGlobalFlag("ger_scw_claims_on_spain_opened"),
