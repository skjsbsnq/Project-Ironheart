                        AddWarSupport(0.05),
                        AddNamedThreat(2.0),
                        SetCountryFlag("godesberg_done"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.munich_agreement",
            title: "The Munich Agreement",
            description: "Chamberlain, Daladier, Mussolini and the Fuehrer have signed. The Sudetenland is ours without a shot fired. \"Peace for our time.\"",
            picture: "GFX_event_munich",
            scope: News,
            trigger: And([
                Date(year: 1938, month: 9, day: 30),
                HasCountryFlag("godesberg_done"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Triumph without war.",
                    effects: [
                        AddPoliticalPower(75.0),
                        AddStability(0.10),
                        AddWarSupport(0.05),
                        SetCountryFlag("munich_agreement"),
                    ],
                ),
                EventOption(
                    name: "Reject — we want all of Czechoslovakia.",
                    trigger: WarSupport(0.5),
                    effects: [
                        AddWarSupport(0.10),
                        AddNamedThreat(5.0),
                        AddOpinion(target: "ENG", amount: -25),
                    ],
                    ai_chance: 0.2,
                ),
            ],
        ),

        Event(
            id: "germany.kristallnacht",
            title: "Kristallnacht",
            description: "Coordinated attacks on Jewish businesses, synagogues and homes have spread across the Reich. The world is appalled. Goebbels claims it was \"spontaneous outrage.\"",
            picture: "GFX_event_kristallnacht",
            trigger: And([
                Date(year: 1938, month: 11, day: 9),
                HasGovernment("fascism"),
                HasCompletedFocus("GER_anschluss"),
