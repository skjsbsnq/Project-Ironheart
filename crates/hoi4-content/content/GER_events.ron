        Event(
            id: "germany.memel_ultimatum",
            title: "Ultimatum to Lithuania",
            description: "We have demanded the immediate return of Memel. Lithuania, isolated, complies within hours.",
            picture: "GFX_event_memel",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Accept the surrender.",
                    effects: [
                        AddPoliticalPower(25.0),
                        SetCountryFlag("memel_returned"),
                    ],
                ),
            ],
