        Event(
            id: "germany.godesberg",
            title: "Godesberg Memorandum",
            description: "Chamberlain returns. Our terms have hardened: full annexation by 1 October. He recoils, but consults his cabinet.",
            picture: "GFX_event_godesberg",
            trigger: And([
                Date(year: 1938, month: 9, day: 22),
                HasCountryFlag("berchtesgaden_done"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
