        ),

        // ═════════════════════════════════════════════════════════════════
        // 1939
        // ═════════════════════════════════════════════════════════════════
        Event(
            id: "germany.prague",
            title: "The Occupation of Prague",
            description: "Wehrmacht columns enter Prague at dawn. The remainder of Bohemia and Moravia is now a Reich Protectorate. London and Paris are stunned.",
