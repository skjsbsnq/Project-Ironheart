        Event(
            id: "germany.economy_crisis_1938",
            title: "The 1938 Economic Crisis",
            description: "Foreign currency reserves are at zero. The MEFO bills come due. Goering insists the only path is more war, more loot.",
            picture: "GFX_event_economy_crisis",
            trigger: And([
                Date(year: 1938, month: 10, day: 1),
                HasIdea("four_year_plan"),
                HasCountryFlag("schacht_resigned"),
