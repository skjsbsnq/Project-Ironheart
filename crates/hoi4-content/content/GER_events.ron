// V5 阶段 F.1：德国 1936-1939 核心事件库（自研，不解析 vanilla）。
//
// 共 50 个事件，覆盖：
//   - 主线历史节点（Rhineland → 4-Year Plan → Anschluss → Sudetenland → Munich →
//     Memel → Pact of Steel → Molotov-Ribbentrop → Danzig / Polish War）
//   - 配套外交事件（Anti-Comintern / Rome-Berlin Axis / Stresa Front collapse /
//     Italy-Albania / UK-FR DoW / Belgian neutrality 等）
//   - 1936 国内整合（Plebiscite / Himmler-SS / Wehrgesetz 2 年制 / He-111 服役 /
//     Madrid 围城 / Hitler-Jugend 强制法）
//   - 国内事件（Olympics / Hossbach / Blomberg-Fritsch / Kristallnacht / Strength
//     through Joy / Autobahn / Schacht resigns / Nuremberg Rally / Hitler 50th）
//   - 战时事件（Gleiwitz / Warsaw falls / Poland Partition / Condor Legion
//     /Madrid / Guernica / 归国）
//
// 触发：大部分按日期（`Date(year, month, day)`）+ 必要前置 focus / flag；少数
// 由 focus 完成时 `Effect::TriggerEvent` 主动触发（is_triggered_only=true）。
//
// MTTH 约定：日期驱动的历史事件用 `mean_time_to_happen_days: 1`，pp 概率 100%
// 等价立即触发（保留字段为日后调谐留口）。多分支的反应事件用 5–10。
//
// Effect 引用的 ideas / state-id 已对齐 D.3 GER focus tree（state 4=Vienna,
// 69=Sudeten, 70/71=Bohemia/Slovakia, 188=Memel, 55/56/57/58/64=工业重镇）。

EventDb(
    events: [
        // ═════════════════════════════════════════════════════════════════
        // 1936
        // ═════════════════════════════════════════════════════════════════
        Event(
            id: "germany.rhineland",
            title: "Remilitarisation of the Rhineland",
            description: "Wehrmacht troops have crossed back into the demilitarised zone. The Versailles Treaty is in tatters. France and Britain have not moved a single unit. The Reich's prestige soars.",
            picture: "GFX_event_rhineland",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Glory to the Reich!",
                    effects: [
                        AddWarSupport(0.05),
                        SetCountryFlag("rhineland_remilitarised"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.reichstag_plebiscite",
            title: "The 99% Plebiscite",
            description: "The Reichstag election doubles as a plebiscite endorsing the Rhineland coup. Goebbels announces 99% in favour. Even sceptical foreign observers call it the most efficient ballot ever stuffed.",
            picture: "GFX_event_plebiscite",
            trigger: And([
                Date(year: 1936, month: 3, day: 29),
                HasCountryFlag("rhineland_remilitarised"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "The Volk has spoken.",
                    effects: [
                        AddPoliticalPower(50.0),
                        AddStability(0.05),
                        AddPopularity(ideology: "fascism", amount: 0.05),
                        SetCountryFlag("plebiscite_done"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.stresa_front_collapses",
            title: "Italy Conquers Ethiopia",
            description: "Mussolini has crushed Haile Selassie. Britain and France imposed sanctions in vain; the League of Nations is humiliated. The Stresa Front against us is dead.",
            picture: "GFX_event_stresa_dead",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Court Italy.",
                    effects: [
                        AddOpinion(target: "ITA", amount: 30),
                        AddNamedThreat(1.0),
                        SetCountryFlag("stresa_dead"),
                    ],
                    ai_chance: 0.7,
                ),
                EventOption(
                    name: "Stay aloof — let Italy bleed.",
                    effects: [
                        AddPoliticalPower(15.0),
                        SetCountryFlag("stresa_dead"),
                    ],
                    ai_chance: 0.3,
                ),
            ],
        ),

        Event(
            id: "germany.himmler_police_chief",
            title: "Himmler — Reichsfuehrer-SS and Chief of Police",
            description: "Heinrich Himmler has been appointed Chief of the German Police. The SS now absorbs the Gestapo, the Kripo, and the Ordnungspolizei. The security state is unified.",
            picture: "GFX_event_himmler",
            trigger: And([
                Date(year: 1936, month: 6, day: 17),
                HasCompletedFocus("GER_rhineland"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "A unified Reich, a unified watch.",
                    effects: [
                        AddPoliticalPower(25.0),
                        AddStability(0.03),
                        AddPopularity(ideology: "fascism", amount: 0.02),
                        SetCountryFlag("ss_unified"),
                    ],
                ),
                EventOption(
                    name: "Pour resources into the Gestapo.",
                    effects: [
                        AddPoliticalPower(50.0),
                        AddStability(-0.03),
                        AddPopularity(ideology: "fascism", amount: 0.03),
                        SetCountryFlag("ss_unified"),
                    ],
                    ai_chance: 0.4,
                ),
            ],
        ),

        Event(
            id: "germany.wehrgesetz_2yr",
            title: "Two-Year Conscription",
            description: "The Wehrgesetz has been amended. Military service is extended from one to two years. The Wehrmacht's peacetime strength will double within the year.",
            picture: "GFX_event_conscription",
            trigger: And([
                Date(year: 1936, month: 8, day: 24),
                HasCompletedFocus("GER_rhineland"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Train them harder.",
                    effects: [
                        AddManpower(200000),
                        ArmyExperience(15.0),
                        AddConscription(0.02),
                        SetCountryFlag("two_year_service"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.he111_service",
            title: "He-111 Enters Squadron Service",
            description: "Heinkel's He-111 medium bomber begins squadron service. Disguised as an airliner for export, the type is in fact the spine of our future bomber arm.",
            picture: "GFX_event_he111",
            trigger: And([
                Date(year: 1936, month: 9, day: 19),
                HasCompletedFocus("GER_air_innovation"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Push production schedules.",
                    effects: [
                        AirExperience(15.0),
                        AddTechBonus(category: "medium_air", bonus: 0.5),
                        AddPoliticalPower(15.0),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.madrid_siege",
            title: "The Siege of Madrid",
            description: "Nationalist forces close on Madrid. The Condor Legion is reinforced with Panzer I detachments and Flak-88 batteries; our crews learn what real combat feels like.",
            picture: "GFX_event_madrid",
            trigger: And([
                Date(year: 1936, month: 11, day: 6),
                HasCountryFlag("condor_legion_active"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Test the Flak-88 in anger.",
                    effects: [
                        ArmyExperience(15.0),
                        AirExperience(15.0),
                        AddTechBonus(category: "armor", bonus: 0.25),
                        AddOpinion(target: "ITA", amount: 10),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.hitler_youth_law",
            title: "Hitler Youth Law",
            description: "Membership in the Hitlerjugend is now compulsory for all Aryan boys aged 10 to 18. Baldur von Schirach beams. Twelve million children in brown shirts.",
            picture: "GFX_event_hj_law",
            trigger: And([
                Date(year: 1936, month: 12, day: 1),
                HasGovernment("fascism"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Indoctrinate the next generation.",
                    effects: [
                        AddPopularity(ideology: "fascism", amount: 0.05),
                        AddManpower(50000),
                        AddPoliticalPower(20.0),
                        SetCountryFlag("hj_compulsory"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.olympics_berlin",
            title: "The Berlin Olympics",
            description: "The 1936 Summer Games open in Berlin. Foreign visitors marvel at our achievements; the regime gleams in newsreels around the world.",
            picture: "GFX_event_olympics",
            trigger: And([
                Date(year: 1936, month: 8, day: 1),
                HasCompletedFocus("GER_rhineland"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "A propaganda triumph.",
                    effects: [
                        AddPoliticalPower(25.0),
                        AddStability(0.05),
                    ],
                ),
                EventOption(
                    name: "Spend more on infrastructure.",
                    effects: [
                        AddBuildingAllStates(building: "infrastructure", level: 1),
                    ],
                    ai_chance: 0.3,
                ),
            ],
        ),

        Event(
            id: "germany.spanish_civil_war",
            title: "Spanish Civil War",
            description: "Generals Mola and Franco have rebelled against the Republic. Italy is sending arms. Will we intervene?",
            picture: "GFX_event_spanish_civil_war",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Form the Condor Legion.",
                    effects: [
                        AirExperience(20.0),
                        ArmyExperience(15.0),
                        AddOpinion(target: "ITA", amount: 25),
                        SetCountryFlag("condor_legion_active"),
                    ],
                    ai_chance: 0.8,
                ),
                EventOption(
                    name: "Stay out of Spanish affairs.",
                    effects: [
                        AddPoliticalPower(15.0),
                    ],
                    ai_chance: 0.2,
                ),
            ],
        ),

        Event(
            id: "germany.four_year_plan_launch",
            title: "The Four Year Plan",
            description: "Goering has been appointed Plenipotentiary for the Four Year Plan. Within four years our economy must be ready for war and our armed forces must be ready for combat.",
            picture: "GFX_event_four_year_plan",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Forward, Reichsmarschall.",
                    effects: [
                        AddPoliticalPower(20.0),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.rome_berlin_axis",
            title: "The Rome-Berlin Axis",
            description: "Mussolini has declared the existence of an axis connecting our two states. Italy and Germany now stand together against the Western democracies.",
            picture: "GFX_event_rome_berlin_axis",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Hail Caesar!",
                    effects: [
                        AddOpinion(target: "ITA", amount: 50),
                        AddPoliticalPower(20.0),
                        SetCountryFlag("rome_berlin_axis"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.anti_comintern_pact",
            title: "The Anti-Comintern Pact",
            description: "Japan has joined us in a pact directed against the Communist International. The Soviet menace will be encircled from East and West.",
            picture: "GFX_event_anti_comintern",
            trigger: And([
                HasCountryFlag("rome_berlin_axis"),
                Date(year: 1938, month: 11, day: 25),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Sign the pact.",
                    effects: [
                        AddOpinion(target: "JAP", amount: 50),
                        AddOpinion(target: "SOV", amount: -25),
                        SetCountryFlag("anti_comintern_pact"),
                    ],
                ),
            ],
        ),

        // ═════════════════════════════════════════════════════════════════
        // 1937
        // ═════════════════════════════════════════════════════════════════
        Event(
            id: "germany.autobahn",
            title: "The Autobahn Network",
            description: "Construction of the Autobahn continues at breakneck pace. Each new stretch is paraded as proof of the regime's modernity.",
            picture: "GFX_event_autobahn",
            trigger: And([
                Date(year: 1937, month: 1, day: 1),
                HasCompletedFocus("GER_four_year_plan"),
            ]),
            mean_time_to_happen_days: 60,
            options: [
                EventOption(
                    name: "Continue construction.",
                    effects: [
                        AddBuildingAllStates(building: "infrastructure", level: 1),
                        AddPoliticalPower(15.0),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.kdf_program",
            title: "Strength Through Joy",
            description: "The Kraft durch Freude movement promises every German family a Volkswagen. Public morale is soaring.",
            picture: "GFX_event_kdf",
            trigger: And([
                Date(year: 1937, month: 2, day: 1),
                HasCompletedFocus("GER_four_year_plan"),
            ]),
            mean_time_to_happen_days: 30,
            options: [
                EventOption(
                    name: "Long live the Volk!",
                    effects: [
                        AddStability(0.05),
                        AddPoliticalPower(15.0),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.condor_legion_battle",
            title: "Condor Legion at Guernica",
            description: "Our pilots have demonstrated devastating new tactics over the Basque country. The world recoils; our airmen learn.",
            picture: "GFX_event_guernica",
            trigger: And([
                Date(year: 1937, month: 4, day: 26),
                HasCountryFlag("condor_legion_active"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Lessons noted.",
                    effects: [
                        AirExperience(25.0),
                        AddTechBonus(category: "air_doctrine", bonus: 0.25),
                        AddNamedThreat(2.0),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.schacht_resigns",
            title: "Schacht Resigns",
            description: "Hjalmar Schacht has resigned as Minister of Economics. He warns that rearmament without exports cannot continue. Goering will absorb his portfolio.",
            picture: "GFX_event_schacht",
            trigger: And([
                Date(year: 1937, month: 11, day: 26),
                HasIdea("four_year_plan"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Goering takes the helm.",
                    effects: [
                        AddPoliticalPower(-25.0),
                        AddStability(-0.03),
                        SetCountryFlag("schacht_resigned"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.hossbach_memorandum",
            title: "The Hossbach Memorandum",
            description: "In a secret conference, the Fuehrer outlines his plans for Lebensraum to the heads of the armed forces. Some generals balk.",
            picture: "GFX_event_hossbach",
            trigger: And([
                Date(year: 1937, month: 11, day: 5),
                HasCompletedFocus("GER_four_year_plan"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "The path is set.",
                    effects: [
                        AddWarSupport(0.05),
                        AddPoliticalPower(20.0),
                        SetCountryFlag("hossbach_memorandum"),
                    ],
                ),
            ],
        ),

        // ═════════════════════════════════════════════════════════════════
        // 1938
        // ═════════════════════════════════════════════════════════════════
        Event(
            id: "germany.blomberg_fritsch_affair",
            title: "The Blomberg-Fritsch Affair",
            description: "War Minister Blomberg has been compromised by his new bride's past. General von Fritsch faces fabricated charges. Hitler dissolves the War Ministry and takes personal command.",
            picture: "GFX_event_blomberg_fritsch",
            trigger: And([
                Date(year: 1938, month: 2, day: 4),
                HasCompletedFocus("GER_rhineland"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Consolidate command.",
                    effects: [
                        AddPoliticalPower(50.0),
                        ArmyExperience(-10.0),
                        AddStability(-0.05),
                        SetCountryFlag("okw_established"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.anschluss",
            title: "Anschluss",
            description: "Austrian Chancellor Schuschnigg has resigned. Our troops cross the border to thunderous applause. Vienna is once again part of the Reich.",
            picture: "GFX_event_anschluss",
            is_triggered_only: true,
            trigger: AlwaysTrue,
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "One people, one Reich!",
                    effects: [
                        AddStability(0.05),
                        SetCountryFlag("anschluss_done"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.austrian_referendum",
            title: "The Austrian Referendum",
            description: "99.7% have voted in favour of unification with Germany. Even our cynics are surprised by the figure.",
            picture: "GFX_event_austrian_referendum",
            trigger: And([
                Date(year: 1938, month: 4, day: 10),
                HasCountryFlag("anschluss_done"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Print the figures.",
                    effects: [
                        AddPoliticalPower(25.0),
                        AddStability(0.05),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.henlein_demands",
            title: "Henlein's Karlsbad Programme",
            description: "Konrad Henlein, leader of the Sudeten Germans, has issued his eight demands at Karlsbad. Prague refuses. The first crisis of the Reich's borders begins.",
            picture: "GFX_event_henlein",
            trigger: And([
                Date(year: 1938, month: 4, day: 24),
                HasCompletedFocus("GER_anschluss"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Press for autonomy.",
                    effects: [
                        AddOpinion(target: "CZE", amount: -25),
                        AddNamedThreat(1.0),
                        SetCountryFlag("sudeten_crisis_begun"),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.may_crisis",
            title: "The May Crisis",
            description: "Czechoslovakia has called partial mobilisation. London and Paris warn us against any sudden moves. Our timing is off; we must regroup.",
            picture: "GFX_event_may_crisis",
            trigger: And([
                Date(year: 1938, month: 5, day: 21),
                HasCountryFlag("sudeten_crisis_begun"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Bide our time.",
                    effects: [
                        AddPoliticalPower(-15.0),
                        AddNamedThreat(1.0),
                        AddOpinion(target: "ENG", amount: -10),
                    ],
                ),
            ],
        ),

        Event(
            id: "germany.berchtesgaden",
            title: "Berchtesgaden Conference",
            description: "Chamberlain has flown to the Berghof. The British wish to broker a peaceful transfer of the Sudetenland.",
            picture: "GFX_event_chamberlain",
            trigger: And([
                Date(year: 1938, month: 9, day: 15),
                HasCountryFlag("sudeten_crisis_begun"),
            ]),
            mean_time_to_happen_days: 1,
            options: [
                EventOption(
                    name: "Demand the Sudetenland.",
                    effects: [
                        AddPoliticalPower(20.0),
                        AddNamedThreat(2.0),
                        SetCountryFlag("berchtesgaden_done"),
                    ],
                ),
            ],
