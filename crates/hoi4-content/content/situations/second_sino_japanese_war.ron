SituationDb(
    situations: [
        SituationDef(
            id: "second_sino_japanese_war",
            title: "全面抗战",
            description: "卢沟桥事变已经扩大为日本与中国统一战线之间的全面战争。",
            sides: [
                SituationSide(id: "japan", name: "日本", color: (188, 0, 45), initial_progress: 50.0, default_supporters: ["JAP", "MAN", "MEN", "HBC"]),
                SituationSide(id: "china", name: "中国统一战线", color: (0, 86, 168), initial_progress: 50.0, default_supporters: ["CHI", "SND", "PRC", "SHX", "GXC", "GDC", "YUN", "XAJ", "SIC", "XSM", "SIK"]),
            ],
            interventions: [],
            base_progress: [0.0, 0.0],
            progress_source: TerritorialControl(side_country_tags: [["JAP", "MAN", "MEN", "HBC"], ["CHI", "SND", "PRC", "SHX", "GXC", "GDC", "YUN", "XAJ", "SIC", "XSM", "SIK"]]),
            milestones: [],
            milestone_effects: [],
            start_date: (1937, 7, 7),
            end_date: (1946, 1, 1),
            on_start: [
                TriggerEvent("news.marco_polo_bridge_incident"),
                CreateWar(attacker: "JAP", defender: "CHI"),
                AddWarParticipant(war_leader: "JAP", participant: "MAN"),
                AddWarParticipant(war_leader: "JAP", participant: "MEN"),
                AddWarParticipant(war_leader: "JAP", participant: "HBC"),
                GrantMilitaryAccess(grantor: "MAN", grantee: "JAP"),
                GrantMilitaryAccess(grantor: "MEN", grantee: "JAP"),
                GrantMilitaryAccess(grantor: "HBC", grantee: "JAP"),
                GrantMilitaryAccess(grantor: "JAP", grantee: "MAN"),
                GrantMilitaryAccess(grantor: "JAP", grantee: "MEN"),
                GrantMilitaryAccess(grantor: "JAP", grantee: "HBC"),
                CreateFaction(leader: "CHI", name: "中国统一战线"),
                AddToFaction(faction_leader: "CHI", member: "SND"),
                AddToFaction(faction_leader: "CHI", member: "PRC"),
                AddToFaction(faction_leader: "CHI", member: "SHX"),
                AddToFaction(faction_leader: "CHI", member: "GXC"),
                AddToFaction(faction_leader: "CHI", member: "GDC"),
                AddToFaction(faction_leader: "CHI", member: "YUN"),
                AddToFaction(faction_leader: "CHI", member: "XAJ"),
                AddToFaction(faction_leader: "CHI", member: "SIC"),
                AddToFaction(faction_leader: "CHI", member: "XSM"),
                AddToFaction(faction_leader: "CHI", member: "SIK"),
                AddWarParticipant(war_leader: "CHI", participant: "SND"),
                AddWarParticipant(war_leader: "CHI", participant: "SHX"),
                // P0.11：地方军阀加入统一战线但延迟参战，不被 reconcile 自动拉入
                // PRC 初期不作为正面国家参战，避免被日本 AI 当作华北主攻目标迅速清退。
                SetWarJoinPolicy(war_leader: "CHI", country: "PRC", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "GXC", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "GDC", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "YUN", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "XAJ", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "SIC", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "XSM", policy: "Delayed"),
                SetWarJoinPolicy(war_leader: "CHI", country: "SIK", policy: "Delayed"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "SND"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "PRC"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "SHX"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "GXC"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "GDC"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "YUN"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "XAJ"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "SIC"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "XSM"),
                GrantMilitaryAccess(grantor: "CHI", grantee: "SIK"),
                GrantMilitaryAccess(grantor: "SND", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "PRC", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "SHX", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "GXC", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "GDC", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "YUN", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "XAJ", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "SIC", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "XSM", grantee: "CHI"),
                GrantMilitaryAccess(grantor: "SIK", grantee: "CHI"),
                AddWarSupport(country: "CHI", amount: 0.12),
                AddWarSupport(country: "JAP", amount: 0.08),
                AddStability(country: "CHI", amount: 0.03),
                AddIdea(country: "JAP", idea: "jap_continental_offensive_momentum"),
                AddIdea(country: "JAP", idea: "jap_north_china_expeditionary_expansion"),
                AddIdea(country: "JAP", idea: "jap_china_incident_expansion"),
                AddIdea(country: "CHI", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "CHI", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "CHI", idea: "chi_theater_command_delay"),
                AddIdea(country: "SND", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "SND", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "SND", idea: "chi_theater_command_delay"),
                AddIdea(country: "PRC", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "PRC", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "PRC", idea: "chi_theater_command_delay"),
                AddIdea(country: "SHX", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "SHX", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "SHX", idea: "chi_theater_command_delay"),
                AddIdea(country: "GXC", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "GXC", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "GDC", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "GDC", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "YUN", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "YUN", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "XAJ", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "XAJ", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "SIC", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "SIC", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "XSM", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "XSM", idea: "chi_regional_command_autonomy"),
                AddIdea(country: "SIK", idea: "chi_united_front_coordination_difficulties"),
                AddIdea(country: "SIK", idea: "chi_regional_command_autonomy"),
                SetCountryFlag(country: "CHI", flag: "anti_japanese_united_front"),
                SetCountryFlag(country: "CHI", flag: "regional_command_autonomy"),
                SetCountryFlag(country: "CHI", flag: "defense_of_north_china"),
                SetCountryFlag(country: "CHI", flag: "defense_of_shandong"),
                SetCountryFlag(country: "JAP", flag: "china_incident_escalated"),
                SetCountryFlag(country: "JAP", flag: "jap_priority_north_china"),
            ],
            on_end: [
                [TriggerEvent("news.sino_japanese_war_japanese_victory")],
                [TriggerEvent("news.sino_japanese_war_chinese_victory")],
            ],
