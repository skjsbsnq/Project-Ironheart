SituationDb(
    situations: [
        SituationDef(
            id: "pacific_war",
            title: "Pacific War",
            description: "Japan's attack on Pearl Harbor brings the United States and the British Empire into a naval, air and island war across the Pacific.",
            sides: [
                SituationSide(id: "japan", name: "Japan", color: (188, 0, 45), initial_progress: 50.0, default_supporters: ["JAP", "MAN", "MEN"]),
                SituationSide(id: "allies", name: "Pacific Allies", color: (35, 80, 170), initial_progress: 50.0, default_supporters: ["USA", "ENG", "AST", "NZL", "RAJ", "MAL", "PHI", "HOL", "INS"]),
            ],
            interventions: [],
            base_progress: [0.0, 0.0],
            progress_source: TerritorialControl(side_country_tags: [["JAP", "MAN", "MEN"], ["USA", "ENG", "AST", "NZL", "RAJ", "MAL", "PHI", "HOL", "INS"]]),
            milestones: [
                (1, 58.0, "news.battle_of_midway"),
                (1, 65.0, "news.guadalcanal_campaign"),
                (1, 75.0, "news.pacific_allied_momentum"),
            ],
            milestone_effects: [
                [TriggerEvent("news.battle_of_midway")],
                [TriggerEvent("news.guadalcanal_campaign")],
                [TriggerEvent("news.pacific_allied_momentum")],
            ],
            start_date: (1941, 12, 7),
            end_date: (1946, 1, 1),
            on_start: [
                TriggerEvent("news.pearl_harbor"),
                TriggerEvent("japan.pearl_harbor_strike"),
                TriggerEvent("usa.pearl_harbor_attacked"),
                CreateWar(attacker: "JAP", defender: "USA"),
                CreateWar(attacker: "JAP", defender: "ENG"),
                AddWarParticipant(war_leader: "JAP", participant: "MAN"),
                AddWarParticipant(war_leader: "JAP", participant: "MEN"),
                AddWarParticipant(war_leader: "USA", participant: "ENG"),
                AddWarParticipant(war_leader: "USA", participant: "AST"),
                AddWarParticipant(war_leader: "USA", participant: "NZL"),
                AddWarParticipant(war_leader: "USA", participant: "RAJ"),
                AddWarParticipant(war_leader: "USA", participant: "MAL"),
                AddWarParticipant(war_leader: "USA", participant: "PHI"),
                AddWarParticipant(war_leader: "USA", participant: "HOL"),
                AddWarParticipant(war_leader: "USA", participant: "INS"),
                CreateFaction(leader: "USA", name: "United Nations"),
                AddToFaction(faction_leader: "USA", member: "ENG"),
                AddToFaction(faction_leader: "USA", member: "AST"),
                AddToFaction(faction_leader: "USA", member: "NZL"),
                AddToFaction(faction_leader: "USA", member: "RAJ"),
                AddToFaction(faction_leader: "USA", member: "MAL"),
                GrantMilitaryAccess(grantor: "USA", grantee: "ENG"),
                GrantMilitaryAccess(grantor: "ENG", grantee: "USA"),
                GrantMilitaryAccess(grantor: "AST", grantee: "USA"),
                GrantMilitaryAccess(grantor: "MAL", grantee: "ENG"),
                GrantMilitaryAccess(grantor: "RAJ", grantee: "ENG"),
                AddWarSupport(country: "USA", amount: 0.35),
                AddWarSupport(country: "JAP", amount: 0.15),
                AddWarSupport(country: "ENG", amount: 0.10),
                SetCountryFlag(country: "JAP", flag: "pacific_war_started"),
                SetCountryFlag(country: "USA", flag: "pacific_war_started"),
                SetCountryFlag(country: "USA", flag: "pearl_harbor_attacked"),
            ],
            on_end: [
                [SetCountryFlag(country: "JAP", flag: "pacific_war_japanese_victory")],
                [SetCountryFlag(country: "USA", flag: "pacific_war_allied_victory")],
            ],
        ),
        SituationDef(
            id: "southern_resource_area",
            title: "Southern Resource Area",
            description: "Japan's southern advance targets Malaya, Singapore, the Philippines and the Dutch East Indies. Convoys, escorts and landing support determine the pace of the campaign.",
            sides: [
                SituationSide(id: "japan", name: "Japan", color: (188, 0, 45), initial_progress: 50.0, default_supporters: ["JAP"]),
                SituationSide(id: "allies", name: "Colonial Allies", color: (35, 80, 170), initial_progress: 50.0, default_supporters: ["ENG", "MAL", "PHI", "HOL", "INS", "RAJ"]),
            ],
            interventions: [],
            base_progress: [0.0, 0.0],
            progress_source: TerritorialControl(side_country_tags: [["JAP"], ["ENG", "MAL", "PHI", "HOL", "INS", "RAJ"]]),
            milestones: [
                (0, 60.0, "news.fall_of_singapore"),
                (0, 70.0, "news.dutch_east_indies_campaign"),
            ],
            milestone_effects: [
                [TriggerEvent("news.fall_of_singapore")],
                [TriggerEvent("news.dutch_east_indies_campaign")],
            ],
            start_date: (1941, 12, 8),
