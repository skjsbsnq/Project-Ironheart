                AddWarSupport(country: "JAP", amount: 0.08),
                SetCountryFlag(country: "JAP", flag: "southern_resource_area_started"),
                SetCountryFlag(country: "JAP", flag: "jap_priority_malaya_singapore"),
                SetCountryFlag(country: "JAP", flag: "jap_priority_philippines"),
                SetCountryFlag(country: "JAP", flag: "jap_priority_dutch_east_indies"),
            ],
            on_end: [
