SituationDb(
    situations: [
        SituationDef(
            id: "weserubung_and_western_campaign",
            title: "Weserubung and the Western Campaign",
            description: "Germany opens the war in Scandinavia and the west, drawing Denmark, Norway and the Low Countries into the conflict before the decisive battle for France.",
            sides: [
                SituationSide(id: "axis", name: "Germany", color: (90, 90, 90), initial_progress: 50.0, default_supporters: ["GER"]),
                SituationSide(id: "western_allies", name: "Western Allies", color: (35, 80, 170), initial_progress: 50.0, default_supporters: ["ENG", "FRA", "DEN", "NOR", "HOL", "BEL", "LUX"]),
            ],
            interventions: [],
            base_progress: [0.0, 0.0],
            progress_source: TerritorialControl(side_country_tags: [["GER", "ITA"], ["ENG", "FRA", "DEN", "NOR", "HOL", "BEL", "LUX"]]),
            milestones: [
                (0, 75.0, "news.fall_of_france_runtime"),
            ],
            milestone_effects: [
                [TriggerEvent("news.fall_of_france_runtime")],
            ],
            start_date: (1940, 4, 9),
            end_date: (1941, 1, 1),
            on_start: [
                TriggerEvent("news.weserubung"),
                CreateWar(attacker: "GER", defender: "DEN"),
                CreateWar(attacker: "GER", defender: "NOR"),
                TriggerEvent("news.battle_of_france_begins"),
                CreateWar(attacker: "GER", defender: "HOL"),
                CreateWar(attacker: "GER", defender: "BEL"),
                CreateWar(attacker: "GER", defender: "LUX"),
                AddWarParticipant(war_leader: "ENG", participant: "DEN"),
                AddWarParticipant(war_leader: "ENG", participant: "NOR"),
                AddWarParticipant(war_leader: "ENG", participant: "HOL"),
                AddWarParticipant(war_leader: "ENG", participant: "BEL"),
                AddWarParticipant(war_leader: "ENG", participant: "LUX"),
                GrantMilitaryAccess(grantor: "BEL", grantee: "FRA"),
                GrantMilitaryAccess(grantor: "FRA", grantee: "BEL"),
                GrantMilitaryAccess(grantor: "HOL", grantee: "ENG"),
                GrantMilitaryAccess(grantor: "NOR", grantee: "ENG"),
                AddWarSupport(country: "GER", amount: 0.08),
                AddWarSupport(country: "ENG", amount: 0.08),
                AddWarSupport(country: "FRA", amount: 0.08),
                SetCountryFlag(country: "GER", flag: "western_campaign_started"),
                SetCountryFlag(country: "ENG", flag: "norway_campaign_active"),
                SetCountryFlag(country: "FRA", flag: "battle_for_france"),
            ],
            on_end: [
                [TriggerEvent("news.fall_of_france_runtime"), SetCountryFlag(country: "GER", flag: "france_defeated")],
                [SetCountryFlag(country: "FRA", flag: "france_holds")],
            ],
        ),
    ],
)
