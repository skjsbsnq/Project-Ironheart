// 德国决议库。原 V5 阶段 F.2 的 14 个自研决议（VW Werk / Synthetic Oil /
// Mefo Bills / Krupp / Italy / Hungary / Memel / Train Army / Panzerwaffe /
// Partial Mobilisation / Goebbels / KdF / Suppress Opposition / Reichstag）
// 已清空，准备按 1938-1939 历史脉络重写：苏台德 → 慕尼黑 → 斯洛伐克附庸 →
// 波西米亚-摩拉维亚保护国 → 但泽-波兰走廊 等。

DecisionDb(
    decisions: [
        Decision(
            id: "ger.volkswagen_werk",
            name: "Volkswagen Werk",
            description: "Fund the construction of a state-backed motor works.",
            icon: "GFX_decision_volkswagen",
            category: Industry,
            visible: HasGovernment("fascism"),
            available: PoliticalPower(50.0),
            cost_political_power: 50.0,
            days_mission_timeout: 90,
            days_re_enable: 365,
            fire_only_once: true,
            on_activation: [SetCountryFlag("ger_volkswagen_werk_in_progress")],
            on_complete: [
                ClearCountryFlag("ger_volkswagen_werk_in_progress"),
                AddBuildingInState(state: 64, building: "industrial_complex", level: 1),
            ],
            cancel_trigger: HasWar(true),
            on_cancel: [ClearCountryFlag("ger_volkswagen_werk_in_progress")],
        ),
        Decision(
            id: "ger.establish_bohemia_moravia",
            name: "Establish the Protectorate of Bohemia and Moravia",
            description: "Reorganize occupied Czech lands under a Reich protectorate while retaining German oversight.",
            icon: "GFX_decision_generic_political_reform",
            category: Diplomacy,
            visible: And([
                Tag("GER"),
                Not(HasCountryFlag("ger_established_bohemia_moravia")),
                Or([
                    HasCountryFlag("ger_czechoslovakia_partition_started"),
                    And([
                        OwnsState(9),
                        OwnsState(69),
                        OwnsState(70),
                        OwnsState(71),
                        OwnsState(72),
                        OwnsState(73),
                        OwnsState(74),
                        OwnsState(75),
                        OwnsState(664),
                        OwnsState(972),
                    ]),
                ]),
            ]),
            available: And([
                OwnsState(9),
                OwnsState(72),
                OwnsState(75),
            ]),
            cost_political_power: 25.0,
            days_mission_timeout: 0,
            days_re_enable: 0,
            fire_only_once: true,
            on_complete: [
                SetCountryFlag("ger_czechoslovakia_partition_started"),
                SetCountryFlag("ger_established_bohemia_moravia"),
                AnnexCountry("CZE"),
                CreateCountry(tag: "BOM", color: (54, 167, 156), ruling_party: "fascism"),
                TransferStateTo(state: 9, country: "BOM"),
                TransferStateTo(state: 72, country: "BOM"),
                TransferStateTo(state: 75, country: "BOM"),
                AddCoreTo(state: 9, country: "BOM"),
                AddCoreTo(state: 72, country: "BOM"),
                AddCoreTo(state: 75, country: "BOM"),
                PuppetCountry("BOM"),
                AddNamedThreat(1.0),
            ],
        ),
        Decision(
            id: "ger.establish_slovakia",
            name: "Establish the Slovak Republic",
            description: "Separate Slovakia from occupied Czechoslovakia and bind the new government to Berlin.",
            icon: "GFX_decision_generic_diplomatic_pressure",
            category: Diplomacy,
            visible: And([
                Tag("GER"),
                Not(HasCountryFlag("ger_established_slovakia")),
                Or([
                    HasCountryFlag("ger_czechoslovakia_partition_started"),
                    And([
                        OwnsState(9),
                        OwnsState(69),
                        OwnsState(70),
                        OwnsState(71),
                        OwnsState(72),
                        OwnsState(73),
                        OwnsState(74),
                        OwnsState(75),
                        OwnsState(664),
                        OwnsState(972),
                    ]),
                ]),
            ]),
            available: And([
                OwnsState(70),
                OwnsState(71),
                OwnsState(73),
                OwnsState(664),
            ]),
            cost_political_power: 25.0,
            days_mission_timeout: 0,
            days_re_enable: 0,
            fire_only_once: true,
            on_complete: [
                SetCountryFlag("ger_czechoslovakia_partition_started"),
                SetCountryFlag("ger_established_slovakia"),
                CreateCountry(tag: "SLO", color: (158, 161, 188), ruling_party: "fascism"),
                TransferStateTo(state: 70, country: "SLO"),
                TransferStateTo(state: 71, country: "SLO"),
                TransferStateTo(state: 73, country: "SLO"),
                TransferStateTo(state: 664, country: "SLO"),
                AddCoreTo(state: 70, country: "SLO"),
                AddCoreTo(state: 71, country: "SLO"),
                AddCoreTo(state: 73, country: "SLO"),
                AddCoreTo(state: 664, country: "SLO"),
                PuppetCountry("SLO"),
                AddNamedThreat(1.0),
            ],
        ),
    ],
)
