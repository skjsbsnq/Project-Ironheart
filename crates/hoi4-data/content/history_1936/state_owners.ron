#![enable(implicit_some)]

[
    // Self-authored 1936 start ownership overrides.
    // These entries are the source of truth for disputed/date-scripted European states.
    // We still read vanilla state files for map geometry, province membership, resources,
    // and names, but not for these states' 1936 political ownership.

    // Austria, independent on 1936-01-01. Anschluss happens later by focus/event.
    (state_id: 4, owner: "AUS", cores: ["AUS"]),
    (state_id: 152, owner: "AUS", cores: ["AUS"]),
    (state_id: 153, owner: "AUS", cores: ["AUS"]),
    (state_id: 848, owner: "AUS", cores: ["AUS"]),
    (state_id: 975, owner: "AUS", cores: ["AUS"]),
    (state_id: 976, owner: "AUS", cores: ["AUS"]),

    // Czechoslovakia before Munich and the March 1939 occupation.
    (state_id: 69, owner: "CZE", cores: ["CZE"]),
    (state_id: 74, owner: "CZE", cores: ["CZE"]),
    (state_id: 75, owner: "CZE", cores: ["CZE"]),
    (state_id: 972, owner: "CZE", cores: ["CZE"]),

    // Memel/Klaipeda before the 1939 German ultimatum.
    (state_id: 188, owner: "LIT", cores: ["LIT"]),

    // China 1936 regional governments. Explicit here so future vanilla-history
    // date blocks or DLC changes cannot collapse all China into CHI.
